function mostrarResultadoFinal(resultado) {
    const { total, sucessos, falhas, tempoTotalFormatado } = resultado;

    return new Promise(resolve => {
        const houveFalhas = falhas.length > 0;
        const { overlay, modal } = criarEstruturaModal("640px");

        const header = criarCabecalhoModal(
            houveFalhas ? "⚠️ Disparo finalizado com ocorrências" : "✅ Disparo finalizado com sucesso",
            houveFalhas ? "O processamento terminou, mas alguns registros apresentaram problemas." : "Todos os registros foram processados.",
            houveFalhas ? { fundo: "#f59e0b", texto: "#ffffff" } : { fundo: "#006847", texto: "#ffffff" }
        );

        const conteudo = criarConteudoModal();

        const resumo = document.createElement("div");
        Object.assign(resumo.style, {
            display: "grid",
            gridTemplateColumns: "1fr 1fr",
            gap: "16px",
            marginBottom: "24px"
        });

        resumo.appendChild(criarIndicador("TOTAL PROCESSADO", total, "#4b5563"));
        resumo.appendChild(criarIndicador("ENVIADOS", sucessos.length, "#006847"));
        resumo.appendChild(criarIndicador("FALHAS / IGNORADOS", falhas.length, houveFalhas ? "#CE1126" : "#006847"));
        resumo.appendChild(criarIndicador("TEMPO TOTAL", tempoTotalFormatado, "#8b5cf6"));

        conteudo.appendChild(resumo);

        const mensagem = document.createElement("div");

        if (!houveFalhas) {
            mensagem.textContent = "🎉 Excelente! Nenhuma falha foi registrada durante o processamento do lote.";
            Object.assign(mensagem.style, {
                padding: "16px",
                background: "#f0fdf4",
                border: "1px solid #86efac",
                borderRadius: "8px",
                color: "#166534",
                fontSize: "14px",
                lineHeight: "1.5"
            });
        } else {
            mensagem.textContent = `⚠️ Atenção: ${falhas.length} registro(s) apresentaram falha durante o envio. Detalhes disponíveis abaixo.`;
            Object.assign(mensagem.style, {
                padding: "16px",
                background: "#fef9c3",
                border: "1px solid #fde047",
                borderRadius: "8px",
                color: "#854d0e",
                fontSize: "14px",
                lineHeight: "1.5"
            });
        }

        conteudo.appendChild(mensagem);

        if (houveFalhas) {
            const tituloFalhas = document.createElement("div");
            tituloFalhas.textContent = "REGISTROS COM PROBLEMAS";
            Object.assign(tituloFalhas.style, {
                fontSize: "12px",
                fontWeight: "700",
                color: "#6b7280",
                marginTop: "24px",
                marginBottom: "10px"
            });

            conteudo.appendChild(tituloFalhas);
            conteudo.appendChild(criarListaOcorrencias(falhas));
        }

        const footer = criarRodapeModal();

        const botaoFechar = criarBotao("Fechar", {
            background: houveFalhas ? "#f59e0b" : "#006847",
            color: "#ffffff"
        });

        botaoFechar.onclick = () => {
            overlay.remove();
            resolve();
        };

        footer.appendChild(botaoFechar);

        modal.appendChild(header);
        modal.appendChild(conteudo);
        modal.appendChild(footer);

        document.body.appendChild(overlay);
    });
}

