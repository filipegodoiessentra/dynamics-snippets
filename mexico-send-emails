async function enviarEmailDinamico(destinatario, assunto, corpo) {
    try {
        const emailData = {
            subject: assunto,
            description: corpo,
            email_activity_parties: [
                {
                    "partyid_queue@odata.bind": `/queues(${ID_QUEUE})`,
                    participationtypemask: 1
                },
                {
                    addressused: destinatario,
                    participationtypemask: 2
                }
            ]
        };

        const novoEmail = await Xrm.WebApi.createRecord("email", emailData);

        const request = {
            entity: {
                entityType: "email",
                id: novoEmail.id
            },
            IssueSend: true,
            getMetadata: function () {
                return {
                    boundParameter: "entity",
                    operationType: 0,
                    operationName: "SendEmail",
                    parameterTypes: {
                        entity: {
                            typeName: "mscrm.email",
                            structuralProperty: 5
                        },
                        IssueSend: {
                            typeName: "Edm.Boolean",
                            structuralProperty: 1
                        }
                    }
                };
            }
        };

        await Xrm.WebApi.online.execute(request);

        return { sucesso: true, emailId: novoEmail.id };

    } catch (erro) {
        return { sucesso: false, erro: obterMensagemErro(erro) };
    }
}

async function dispararLote(lista) {
    const total = lista.length;
    const saudacao = obterSaudacao();
    const falhas = [];
    const sucessos = [];
    const inicio = performance.now();

    console.log("========================================");
    console.log("🚀 INÍCIO DO DISPARO DE E-MAILS");
    console.log("========================================");
    console.log(`📊 Total de registros encontrados: ${total}`);
    console.log(`🕒 Saudação utilizada: ${saudacao}`);
    console.log("");

    for (let i = 0; i < total; i++) {
        const linha = lista[i];
        const numeroAtual = i + 1;
        const numeroLinhaExcel = i + 2;

        const email = montarEmailDaLinha(linha, saudacao);
        const { id, destinatario, tituloBase, corpoBase, chave, assunto, corpo, variaveisNaoEncontradas } = email;

        const camposAusentes = [];
        if (!destinatario) camposAusentes.push("EMAIL");
        if (!tituloBase) camposAusentes.push("TITULO DO EMAIL");
        if (!id) camposAusentes.push("ID");
        if (!corpoBase) camposAusentes.push("TEXTO");

        const motivosBloqueio = [];
        if (camposAusentes.length > 0) motivosBloqueio.push("Campos obrigatórios ausentes: " + camposAusentes.join(", "));
        if (destinatario && !emailPareceValido(destinatario)) motivosBloqueio.push("EMAIL inválido");
        if (variaveisNaoEncontradas.length > 0) motivosBloqueio.push("Variáveis não encontradas: " + variaveisNaoEncontradas.join(", "));

        if (motivosBloqueio.length > 0) {
            const mensagemErro = motivosBloqueio.join(" | ");
            console.warn(`⚠️ [${numeroAtual}/${total}] Linha ${numeroLinhaExcel} ignorada: ${mensagemErro}`);
            falhas.push({ numero: numeroAtual, linhaExcel: numeroLinhaExcel, destinatario, id, chave, assunto, erro: mensagemErro });
            continue;
        }

        console.log(`⏳ [${numeroAtual}/${total}] Enviando para ${destinatario}...`);
        const resultadoEnvio = await enviarEmailDinamico(destinatario, assunto, corpo);

        if (resultadoEnvio.sucesso) {
            sucessos.push({ numero: numeroAtual, linhaExcel: numeroLinhaExcel, destinatario, id, chave, emailId: resultadoEnvio.emailId });
            console.log(`✅ [${numeroAtual}/${total}] Enviado para: ${destinatario} | ID: ${id}`);
        } else {
            falhas.push({ numero: numeroAtual, linhaExcel: numeroLinhaExcel, destinatario, id, chave, assunto, erro: resultadoEnvio.erro });
            console.error(`❌ [${numeroAtual}/${total}] Falha para: ${destinatario} | ${resultadoEnvio.erro}`);
        }

        if (i < total - 1) {
            await delay(INTERVALO_ENTRE_EMAILS);
        }
    }

    const fim = performance.now();
    const tempoTotal = fim - inicio;

    return {
        total,
        sucessos,
        falhas,
        tempoTotalMilliseconds: tempoTotal,
        tempoTotalFormatado: formatarTempo(tempoTotal)
    };
}

function validarCabecalhos(lista) {
    if (!lista || lista.length === 0) {
        return { valido: false, ausentes: [], mensagem: "A planilha não possui registros." };
    }

    const primeiraLinha = lista[0];
    const cabecalhosEncontrados = Object.keys(primeiraLinha);
    const camposObrigatorios = ["ID", "EMAIL", "TITULO DO EMAIL", "TEXTO"];

    const camposAusentes = camposObrigatorios.filter(campo => {
        return !cabecalhosEncontrados.some(cabecalho => normalizarCabecalho(cabecalho) === normalizarCabecalho(campo));
    });

    if (camposAusentes.length > 0) {
        return { valido: false, ausentes: camposAusentes, mensagem: `Cabeçalhos obrigatórios não encontrados: ` + camposAusentes.join(", ") };
    }

    return { valido: true, ausentes: [], mensagem: "Cabeçalhos válidos." };
}

function carregarExcelLocal() {
    if (typeof XLSX !== "undefined") {
        abrirSeletorExcel();
        return;
    }

    const scriptExistente = document.querySelector('script[src*="xlsx.full.min.js"]');
    if (scriptExistente) {
        abrirSeletorExcel();
        return;
    }

    const script = document.createElement("script");
    script.src = "https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js";

    script.onload = () => {
        console.log("✅ Biblioteca XLSX carregada.");
        abrirSeletorExcel();
    };

    script.onerror = () => {
        console.error("❌ Não foi possível carregar a biblioteca XLSX.");
    };

    document.head.appendChild(script);
}

function abrirSeletorExcel() {
    const input = document.createElement("input");
    input.type = "file";
    input.accept = ".xlsx,.xls";
    input.style.display = "none";

    input.addEventListener("change", evento => {
        const arquivo = evento.target.files?.[0];
        if (!arquivo) return;
        lerArquivoExcel(arquivo);
    });

    document.body.appendChild(input);
    input.click();
    setTimeout(() => { input.remove(); }, 1000);
}

function lerArquivoExcel(arquivo) {
    const leitor = new FileReader();

    leitor.onload = async evento => {
        try {
            const data = new Uint8Array(evento.target.result);
            const workbook = XLSX.read(data, { type: "array" });

            if (!workbook.SheetNames.length) throw new Error("Nenhuma aba foi encontrada na planilha.");

            const primeiraAba = workbook.SheetNames[0];
            const planilha = workbook.Sheets[primeiraAba];
            const listaDeEmails = XLSX.utils.sheet_to_json(planilha, { defval: "", raw: false });

            if (!listaDeEmails.length) throw new Error("A primeira aba da planilha não possui registros.");

            const validacao = validarCabecalhos(listaDeEmails);

            if (!validacao.valido) {
                await mostrarErrosPreValidacao({
                    total: listaDeEmails.length,
                    validos: 0,
                    invalidos: listaDeEmails.length,
                    problemas: [{ linhaExcel: 1, destinatario: "Cabeçalho da planilha", erro: validacao.mensagem }]
                });
                return;
            }

            const preValidacao = preValidarPlanilha(listaDeEmails);

            if (!preValidacao.valido) {
                await mostrarErrosPreValidacao(preValidacao);
                return;
            }

            const usuarioConfirmou = await mostrarPreviewDisparo(listaDeEmails);

            if (!usuarioConfirmou) return;

            const resultado = await dispararLote(listaDeEmails);
            await mostrarResultadoFinal(resultado);

        } catch (erro) {
            console.error("❌ Falha ao processar o Excel:", obterMensagemErro(erro));
        }
    };

    leitor.onerror = () => console.error("❌ Não foi possível ler o arquivo Excel.");
    leitor.readAsArrayBuffer(arquivo);
}

