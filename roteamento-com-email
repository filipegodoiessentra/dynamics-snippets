(async function () {

    try {

        console.clear();
        console.log("====================================");
        console.log("🚀 LEAD ESSENTRA - VERSÃO 6.0");
        console.log("====================================");


        // =========================================================
        // CONFIGURAÇÕES
        // =========================================================

        const VENDEDORES = [

            {
                nome: "Cristiana Roseto",
                id: "df619db6-3a77-eb11-a812-000d3adb5d0d"
            },

            {
                nome: "Pablo Silva",
                id: "67f1a84e-7471-f011-b4cc-000d3adb1307"
            },

            {
                nome: "Matheus Silva",
                id: "d46857cf-606e-f011-b4cc-6045bde0e1bb"
            }

        ];


        const QUEUE_ID =
            "{1DC95BFF-6E36-EC11-8C64-000D3ABA5426}";


        const CAMPANHA_ID =
            "f98d08d3-191e-f111-8341-000d3ab84eef";


        const LEAD_SOURCE =
            810600002;



        // =========================================================
        // 1. LOCALIZAR EMAIL ABERTO NO POPUP
        // =========================================================

        console.log("🔎 Procurando email aberto...");


        const emailsEncontrados = [];


        for (let i = 0; i < window.frames.length; i++) {

            try {

                const frame =
                    window.frames[i];


                const entity =
                    frame.Xrm?.Page?.data?.entity?.getEntityName?.();


                const id =
                    frame.Xrm?.Page?.data?.entity?.getId?.();


                if (
                    entity === "email" &&
                    id
                ) {

                    emailsEncontrados.push({

                        indice: i,

                        frame: frame,

                        id:
                            id.replace(/[{}]/g, "")

                    });

                }

            } catch (e) {

                // Alguns frames do Dynamics bloqueiam acesso.
                // Isso é normal e podemos ignorá-los.

            }

        }



        if (emailsEncontrados.length === 0) {

            alert(
                "❌ Nenhum email aberto foi encontrado.\n\n" +
                "Abra o email no popup e execute o script novamente."
            );

            return;

        }



        // Usa o último email encontrado.
        // Normalmente corresponde ao popup aberto mais recentemente.

        const emailAberto =
            emailsEncontrados[
                emailsEncontrados.length - 1
            ];


        const emailFrame =
            emailAberto.frame;


        const emailOriginalId =
            emailAberto.id;



        console.log(
            "✅ Email encontrado no frame:",
            emailAberto.indice
        );


        console.log(
            "✅ ID do email original:",
            emailOriginalId
        );



        // =========================================================
        // 2. LER CONTEÚDO DO EMAIL
        // =========================================================

        const texto =
            emailFrame.document.body.innerText;



        if (!texto) {

            alert(
                "❌ Não foi possível ler o conteúdo do email."
            );

            return;

        }



        console.log(
            "✅ Conteúdo do email capturado."
        );



        // =========================================================
        // 3. EXTRAIR DADOS DO LEAD
        // =========================================================

        const nomeCompleto =
            texto.match(
                /Nome\s+([^\n]+)/
            )?.[1]?.trim() || "";


        const email =
            texto.match(
                /E-mail\s+([^\n]+)/
            )?.[1]?.trim() || "";


        const telefone =
            texto.match(
                /Telefone\s+([^\n]+)/
            )?.[1]?.trim() || "";


        const descricao =
            texto.match(
                /Escreva aqui o que você precisa\.\s+([^\n]+)/
            )?.[1]?.trim() || "";


        const cidade =
            texto.match(
                /Cidade do Usuário\s+([^\n]+)/
            )?.[1]?.trim() || "";


        const estado =
            texto.match(
                /Região do Usuário\s+([^\n]+)/
            )?.[1]?.trim() || "";



        console.log(
            "===================================="
        );

        console.log(
            "📋 DADOS IDENTIFICADOS"
        );

        console.log(
            "Nome:",
            nomeCompleto
        );

        console.log(
            "Email:",
            email
        );

        console.log(
            "Telefone:",
            telefone
        );

        console.log(
            "Descrição:",
            descricao
        );

        console.log(
            "Cidade:",
            cidade
        );

        console.log(
            "Estado:",
            estado
        );

        console.log(
            "===================================="
        );



        // =========================================================
        // 4. VALIDAR DADOS OBRIGATÓRIOS
        // =========================================================

        if (
            !nomeCompleto ||
            !email
        ) {

            alert(
                "❌ Nome ou Email não encontrados.\n\n" +
                "Verifique se o email correto está aberto."
            );

            return;

        }



        // =========================================================
        // 5. SEPARAR FIRSTNAME / LASTNAME
        // =========================================================

        const partes =
            nomeCompleto
                .trim()
                .split(/\s+/);


        const firstname =
            partes.shift();


        const lastname =
            partes.join(" ") || firstname;



        // =========================================================
        // 6. ROUND ROBIN DOS VENDEDORES
        // =========================================================

        let indice =
            Number(
                localStorage.getItem(
                    "lead_rr"
                ) || 0
            );



        // Proteção caso o localStorage tenha valor inválido

        if (
            Number.isNaN(indice) ||
            indice < 0 ||
            indice >= VENDEDORES.length
        ) {

            indice = 0;

        }



        const vendedor =
            VENDEDORES[indice];


        const proximoIndice =
            (indice + 1) %
            VENDEDORES.length;



        console.log(
            "👤 Vendedor selecionado:",
            vendedor.nome
        );



        // =========================================================
        // 7. CRIAR LEAD
        // =========================================================

        console.log(
            "🚀 Criando Lead..."
        );



        const lead =
            await Xrm.WebApi.createRecord(

                "lead",

                {

                    firstname:
                        firstname,

                    lastname:
                        lastname,

                    companyname:
                        nomeCompleto,

                    emailaddress1:
                        email,

                    telephone1:
                        telefone,

                    description:
                        descricao,

                    address1_city:
                        cidade,

                    address1_stateorprovince:
                        estado,

                    cuk_leadsource:
                        LEAD_SOURCE,

                    "campaignid@odata.bind":
                        `/campaigns(${CAMPANHA_ID})`

                }

            );



        const leadId =
            lead.id.replace(
                /[{}]/g,
                ""
            );



        console.log(
            "✅ Lead criado:",
            leadId
        );



        // =========================================================
        // 8. AVANÇAR ROUND ROBIN SOMENTE APÓS CRIAR LEAD
        // =========================================================

        localStorage.setItem(
            "lead_rr",
            proximoIndice
        );



        console.log(
            "✅ Round Robin atualizado."
        );



        // =========================================================
        // 9. RELACIONAR EMAIL ORIGINAL AO LEAD
        // =========================================================

        console.log(
            "🔗 Relacionando email original ao Lead..."
        );



        await Xrm.WebApi.updateRecord(

            "email",

            emailOriginalId,

            {

                "regardingobjectid_lead@odata.bind":
                    `/leads(${leadId})`

            }

        );



        console.log(
            "✅ Email original relacionado ao Lead."
        );



        // =========================================================
        // 10. ATRIBUIR LEAD AO VENDEDOR
        // =========================================================

        console.log(
            "👤 Atribuindo Lead para:",
            vendedor.nome
        );



        await Xrm.WebApi.updateRecord(

            "lead",

            leadId,

            {

                "ownerid@odata.bind":
                    `/systemusers(${vendedor.id})`

            }

        );



        console.log(
            "✅ Lead atribuído:",
            vendedor.nome
        );



        // =========================================================
        // 11. CRIAR EMAIL DE RESPOSTA
        // =========================================================

        console.log(
            "📧 Criando email de resposta..."
        );



        const emailResposta =
            await Xrm.WebApi.createRecord(

                "email",

                {

                    subject:
                        "Contato Essentra",

                    description:
`Olá ${firstname},<br><br>Muito obrigado pelo seu contato com a Essentra Components.<br><br>Recebemos sua solicitação e para que possamos dar continuidade ao atendimento, poderia nos informar o CNPJ da empresa?<br><br>Assim que recebermos essa informação, retornaremos o mais breve possível.<br><br>Atenciosamente,<br><br>${vendedor.nome}`,

                    "regardingobjectid_lead@odata.bind":
                        `/leads(${leadId})`

                }

            );



        const emailRespostaId =
            emailResposta.id.replace(
                /[{}]/g,
                ""
            );



        console.log(
            "✅ Email de resposta criado:",
            emailRespostaId
        );



        // =========================================================
        // 12. SALVAR HISTÓRICO LOCAL
        // =========================================================

        const historico =
            JSON.parse(
                localStorage.getItem(
                    "lead_log"
                ) || "[]"
            );



        historico.push({

            dataCriacao:
                new Date().toISOString(),

            leadId:
                leadId,

            emailOriginalId:
                emailOriginalId,

            emailRespostaId:
                emailRespostaId,

            nome:
                nomeCompleto,

            email:
                email,

            telefone:
                telefone,

            vendedor:
                vendedor.nome,

            vendedorId:
                vendedor.id,

            status:
                "AguardandoResposta",

            versao:
                "6.0"

        });



        localStorage.setItem(
            "lead_log",
            JSON.stringify(
                historico
            )
        );



        // =========================================================
        // 13. SALVAR ÚLTIMO LEAD
        // =========================================================

        localStorage.setItem(

            "ultimoLead",

            JSON.stringify({

                leadId:
                    leadId,

                emailOriginalId:
                    emailOriginalId,

                emailRespostaId:
                    emailRespostaId,

                nome:
                    nomeCompleto,

                email:
                    email,

                vendedor:
                    vendedor.nome,

                dataCriacao:
                    new Date().toISOString()

            })

        );



        console.log(
            "✅ Histórico salvo."
        );



        // =========================================================
        // 14. ABRIR EMAIL DE RESPOSTA
        // =========================================================

        console.log(
            "📨 Abrindo email de resposta..."
        );



        await Xrm.Navigation.openForm({

            entityName:
                "email",

            entityId:
                emailRespostaId

        });



        // =========================================================
        // 15. LOCALIZAR O NOVO EMAIL ABERTO
        // =========================================================
        //
        // O Dynamics agora trabalha com múltiplos frames.
        // Portanto não utilizamos simplesmente Xrm.Page.
        //
        // Procuramos especificamente o formulário cujo:
        //
        // entity = email
        // id = emailRespostaId
        //
        // =========================================================


        console.log(
            "⏳ Aguardando formulário do novo email carregar..."
        );



        let tentativas =
            0;


        const MAX_TENTATIVAS =
            15;



        const localizarEmailResposta =
            setInterval(

                async () => {

                    tentativas++;


                    console.log(
                        `🔎 Procurando formulário do email (${tentativas}/${MAX_TENTATIVAS})...`
                    );



                    let frameResposta =
                        null;



                    for (
                        let i = 0;
                        i < window.frames.length;
                        i++
                    ) {

                        try {

                            const frame =
                                window.frames[i];


                            const entity =
                                frame.Xrm
                                    ?.Page
                                    ?.data
                                    ?.entity
                                    ?.getEntityName
                                    ?.();


                            const id =
                                frame.Xrm
                                    ?.Page
                                    ?.data
                                    ?.entity
                                    ?.getId
                                    ?.()
                                    ?.replace(
                                        /[{}]/g,
                                        ""
                                    )
                                    ?.toLowerCase();


                            if (
                                entity === "email" &&
                                id ===
                                    emailRespostaId.toLowerCase()
                            ) {

                                frameResposta =
                                    frame;

                                console.log(
                                    "✅ Formulário do novo email encontrado no frame:",
                                    i
                                );

                                break;

                            }


                        } catch (e) {

                            // Ignora frames sem acesso

                        }

                    }



                    if (!frameResposta) {

                        if (
                            tentativas >=
                            MAX_TENTATIVAS
                        ) {

                            clearInterval(
                                localizarEmailResposta
                            );


                            console.warn(
                                "⚠️ Não foi possível localizar o formulário do novo email."
                            );


                            alert(
                                "Lead criado com sucesso!\n\n" +
                                "Vendedor: " +
                                vendedor.nome +
                                "\n\n" +
                                "O email de resposta também foi criado, " +
                                "mas TO e FROM precisam ser conferidos manualmente."
                            );

                        }


                        return;

                    }



                    // Encontramos o formulário.
                    // Para de procurar.

                    clearInterval(
                        localizarEmailResposta
                    );



                    // =================================================
                    // 16. PREENCHER TO E FROM
                    // =================================================

                    try {

                        const emailXrm =
                            frameResposta.Xrm;



                        const campoTo =
                            emailXrm.Page
                                .getAttribute(
                                    "to"
                                );


                        const campoFrom =
                            emailXrm.Page
                                .getAttribute(
                                    "from"
                                );



                        if (!campoTo) {

                            throw new Error(
                                "Campo TO não encontrado."
                            );

                        }


                        if (!campoFrom) {

                            throw new Error(
                                "Campo FROM não encontrado."
                            );

                        }



                        // ---------------------------------------------
                        // TO
                        // ---------------------------------------------

                        campoTo.setValue([

                            {

                                entityType:
                                    "unresolvedaddress",

                                id:
                                    "{00000000-0000-0000-0000-000000000000}",

                                name:
                                    email

                            }

                        ]);



                        console.log(
                            "✅ TO preenchido:",
                            email
                        );



                        // ---------------------------------------------
                        // FROM
                        // ---------------------------------------------

                        campoFrom.setValue([

                            {

                                entityType:
                                    "queue",

                                id:
                                    QUEUE_ID,

                                name:
                                    "CBR Sales"

                            }

                        ]);



                        console.log(
                            "✅ FROM preenchido: CBR Sales"
                        );



                        // ---------------------------------------------
                        // SALVAR
                        // ---------------------------------------------

                        await emailXrm.Page
                            .data
                            .save();



                        console.log(
                            "✅ Email salvo."
                        );


                        console.log(
                            "===================================="
                        );

                        console.log(
                            "🎉 PROCESSO CONCLUÍDO"
                        );

                        console.log(
                            "Lead:",
                            nomeCompleto
                        );

                        console.log(
                            "Vendedor:",
                            vendedor.nome
                        );

                        console.log(
                            "Email:",
                            email
                        );

                        console.log(
                            "===================================="
                        );



                        alert(
                            "✅ Lead criado com sucesso!\n\n" +
                            "Lead: " +
                            nomeCompleto +
                            "\n" +
                            "Vendedor: " +
                            vendedor.nome +
                            "\n\n" +
                            "Confira o email antes de enviar."
                        );


                    } catch (erroEmail) {

                        console.error(
                            "❌ Erro ao preencher TO/FROM:",
                            erroEmail
                        );


                        alert(
                            "Lead criado com sucesso!\n\n" +
                            "Vendedor: " +
                            vendedor.nome +
                            "\n\n" +
                            "Porém houve um erro ao preencher TO/FROM.\n" +
                            "Confira o email manualmente."
                        );

                    }


                },

                1000

            );


    } catch (erro) {

        console.error(
            "❌ ERRO GERAL:",
            erro
        );


        alert(
            "❌ Erro durante a execução.\n\n" +
            "Verifique o Console para mais detalhes."
        );

    }

})();
