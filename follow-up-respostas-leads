    function getFiltrados() {
        let filtrados = resultados;
        
        if (filtroStatus === "erros") {
            filtrados = filtrados.filter(r => (r.status || "").toUpperCase().includes("ERRO"));
        } else if (filtroStatus === "pendentes") {
            filtrados = filtrados.filter(r => (r.status || "").toUpperCase().includes("AGUARDANDO") || (r.status || "").toUpperCase().includes("D+0"));
        } else if (filtroStatus === "vencidos") {
            filtrados = filtrados.filter(r => isVencido(r.fupDate));
        } else if (filtroStatus === "d1") {
            filtrados = filtrados.filter(r => (r.status || "").toUpperCase().endsWith("D+1"));
        } else if (filtroStatus === "d3") {
            filtrados = filtrados.filter(r => (r.status || "").toUpperCase().endsWith("D+3"));
        } else if (filtroStatus === "d7") {
            filtrados = filtrados.filter(r => (r.status || "").toUpperCase().endsWith("D+7"));
        } else if (filtroStatus === "d15") {
            filtrados = filtrados.filter(r => (r.status || "").toUpperCase().endsWith("D+15"));
        } else if (filtroStatus === "d30") {
            filtrados = filtrados.filter(r => (r.status || "").toUpperCase().endsWith("D+30"));
        } else if (filtroStatus === "d60") {
            filtrados = filtrados.filter(r => (r.status || "").toUpperCase().endsWith("D+60"));
        } else if (filtroStatus === "vend") {
            filtrados = filtrados.filter(r => (r.status || "").toUpperCase().includes("VENDEDOR") || (r.status || "").toUpperCase().includes("VENDAS"));
        } else if (filtroStatus === "callplan") {
            filtrados = filtrados.filter(r => (r.status || "").toUpperCase().includes("CALL PLAN"));
        }
        
        if (termoBusca) {
            filtrados = filtrados.filter(r => 
                normalizar(r.ticket).includes(termoBusca) || 
                normalizar(r.titulo).includes(termoBusca) || 
                normalizar(r.status).includes(termoBusca)
            );
        }
        return filtrados;
    }

    function renderLista() {
