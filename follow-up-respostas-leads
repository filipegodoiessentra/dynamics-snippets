    document.getElementById("fg-btn-bulk-callplan").onclick = async function() {
        const btn = this;
        const itensParaProcessar = resultados.filter(r => !r.erro && r.caseId && r.ticket && r.ticket !== "-");
        
        if (!itensParaProcessar.length) return alert("Nenhum item válido para gerar Call Plans.");
        if (!confirm(`Deseja gerar Call Plans para ${itensParaProcessar.length} registro(s)?\n(Casos já existentes serão pulados).`)) return;

        btn.disabled = true;
        const originalText = btn.innerHTML;
        let criados = 0, falhas = 0, existentes = 0;

        for (let i = 0; i < itensParaProcessar.length; i++) {
            const r = itensParaProcessar[i];
            btn.textContent = `⏳ GERANDO (${i+1}/${itensParaProcessar.length})...`;
            
            try {
                const result = await processarCallPlan(r);
                if (result === "EXISTENTE") {
                    r.status = "⚠️ CALL PLAN EXISTENTE";
                    r.statusManual = true;
                    syncLocalStorageStatus(r.emailId, r.status, r.callPlanId, r.fupDate);
                    existentes++;
                } else {
                    r.status = "📞 CALL PLAN CRIADO";
                    r.statusManual = true;
                    syncLocalStorageStatus(r.emailId, r.status, r.callPlanId, r.fupDate);
                    criados++;
                }
            } catch(e) {
                console.error("Erro ao processar CallPlan do Ticket:", r.ticket, e);
                falhas++;
            }
        }

        btn.disabled = false;
        btn.innerHTML = originalText;
        renderLista();
        if(selecionadoIndex !== null) renderDetalhe();

        alert(`Processamento de Call Plans Concluído!\n\n✅ Criados: ${criados}\n⚠️ Já Existiam: ${existentes}\n❌ Falharam: ${falhas}`);
