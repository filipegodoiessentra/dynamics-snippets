    document.getElementById("fg-btn-carregar").onclick = async function() {
        const btn = this;
        const texto = document.getElementById("fg-guids-input").value;
        const guidsLimpos = texto.split("\n").map(x => guid(x.trim())).filter(Boolean);
        
        if (!guidsLimpos.length) return alert("Nenhum GUID válido encontrado.");
        
        btn.disabled = true;
        btn.textContent = "CARREGANDO...";
        
        resultados = [];
        selecionadoIndex = null;
        
        // Puxa o lead_log atualizado a cada novo clique para usar como prioridade
        const leadLog = JSON.parse(localStorage.getItem("lead_log") || "[]");

        for (let i = 0; i < guidsLimpos.length; i++) {
            const emailId = guidsLimpos[i];
            try {
                const email = await Xrm.WebApi.retrieveRecord("email", emailId, "?$select=subject,_regardingobjectid_value,activityid,createdon");
                const caseId = email._regardingobjectid_value;
                const caseType = email["_regardingobjectid_value@Microsoft.Dynamics.CRM.lookuplogicalname"];
                let ticket = "", titulo = "";

                if (caseId && caseType === "incident") {
                    try {
                        const inc = await Xrm.WebApi.retrieveRecord("incident", guid(caseId), "?$select=ticketnumber,title");
                        ticket = inc.ticketnumber || "";
                        titulo = inc.title || "";
                    } catch (e) { console.warn("Erro ao buscar incident:", e.message); }
                } else if (caseId) {
                    titulo = `(Vinculado a ${caseType || 'desconhecido'})`;
                    ticket = "-";
                }

                // =================================================================
                // 1. MÁQUINA DO TEMPO (Cálculo Base)
                // =================================================================
                let statusInicial = "⏳ Aguardando";
                let statusManual = false;
                let callPlanIdLocal = null;
                let fupDateLocal = null;

                if (email.createdon) {
                    const dtEmail = new Date(email.createdon);
                    const dtHoje = new Date();
                    
                    const hoje = new Date(dtHoje.getFullYear(), dtHoje.getMonth(), dtHoje.getDate());
                    const diaEmail = new Date(dtEmail.getFullYear(), dtEmail.getMonth(), dtEmail.getDate());
                    
                    const diffDays = Math.floor((hoje - diaEmail) / (1000 * 60 * 60 * 24));
                    
                    if (diffDays === 1 || diffDays === 2) statusInicial = "⏰ FUP D+1";
                    else if (diffDays >= 3 && diffDays < 7) statusInicial = "⏰ FUP D+3";
                    else if (diffDays >= 7 && diffDays < 15) statusInicial = "⏰ FUP D+7";
                    else if (diffDays >= 15 && diffDays < 30) statusInicial = "⏰ FUP D+15";
                    else if (diffDays >= 30 && diffDays < 60) statusInicial = "⏰ FUP D+30";
                    else if (diffDays >= 60) statusInicial = "⏰ FUP D+60";
                    else if (diffDays === 0) statusInicial = "⏳ D+0 (Criado Hoje)";
                }

                // =================================================================
                // 2. SUBSTITUIÇÃO PELO HISTÓRICO SALVO (Memória Fotográfica)
                // =================================================================
                for(let h of leadLog) {
                    if (guid(h.emailOriginalId) === guid(emailId) || guid(h.emailRespostaId) === guid(emailId)) {
                        if (h.status && h.status !== "Novo" && h.status !== "Existente") {
                            statusInicial = h.status;
                            statusManual = true;
                        }
                        if (h.callPlanId) callPlanIdLocal = h.callPlanId;
                        if (h.fupDate) fupDateLocal = h.fupDate;
                    }
                }

                resultados.push({ 
                    emailId, caseId, assunto: email.subject || "(Sem assunto)", 
                    ticket, titulo, status: statusInicial, statusManual: statusManual, 
                    fupDate: fupDateLocal, callPlanId: callPlanIdLocal 
                });
            } catch (e) {
                resultados.push({ emailId, caseId: null, assunto: "ERRO AO LER EMAIL", ticket: "-", titulo: String(e.message), status: "❌ ERRO", statusManual: true, fupDate: null, callPlanId: null, erro: true });
            }
        }

        btn.disabled = false;
        btn.textContent = "CARREGAR GUIDS";
        transicaoParaTrabalho();
    };

