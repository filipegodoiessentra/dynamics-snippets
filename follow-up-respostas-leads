    btnImportarJson.onclick = () => inputFileJson.click();
    inputFileJson.onchange = function(e) {
        const file = e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = function(evt) {
            try {
                const dados = JSON.parse(evt.target.result);
                if (!Array.isArray(dados)) throw new Error("O arquivo não contém uma lista válida.");
                resultados = dados; 
                transicaoParaTrabalho();
                alert(`✅ Backup carregado com sucesso!\n${resultados.length} registros restaurados.`);
            } catch (err) { alert("Erro ao ler o JSON.\nDetalhe: " + err.message); }
        };
        reader.readAsText(file);
        inputFileJson.value = ""; 
    };

    document.getElementById("fg-btn-carregar").onclick = async function() {
        const btn = this;
        const texto = document.getElementById("fg-guids-input").value;
        const guidsLimpos = texto.split("\n").map(x => guid(x.trim())).filter(Boolean);
        
        if (!guidsLimpos.length) return alert("Nenhum GUID válido encontrado.");
        
        btn.disabled = true;
        btn.textContent = "CARREGANDO...";
        
        resultados = [];
        selecionadoIndex = null;

        for (let i = 0; i < guidsLimpos.length; i++) {
            const emailId = guidsLimpos[i];
            try {
                const email = await Xrm.WebApi.retrieveRecord("email", emailId, "?$select=subject,_regardingobjectid_value,activityid,createdon");
                const caseId = email._regardingobjectid_value;
                let ticket = "", titulo = "";

                if (caseId) {
                    try {
                        const inc = await Xrm.WebApi.retrieveRecord("incident", guid(caseId), "?$select=ticketnumber,title");
                        ticket = inc.ticketnumber || "";
                        titulo = inc.title || "";
                    } catch (e) { console.warn("Erro ao buscar incident:", e); }
                }

                resultados.push({ 
                    emailId, caseId, assunto: email.subject || "(Sem assunto)", 
                    ticket, titulo, status: "Aguardando análise", statusManual: false, 
                    fupDate: null 
                });
            } catch (e) {
                resultados.push({ emailId, caseId: null, assunto: "ERRO AO LER EMAIL", ticket: "-", titulo: String(e.message), status: "❌ ERRO", statusManual: true, fupDate: null });
            }
        }

        btn.disabled = false;
        btn.textContent = "CARREGAR GUIDS";
        transicaoParaTrabalho();
    };

    document.getElementById("fg-busca").addEventListener("input", function() {
        termoBusca = normalizar(this.value);
        renderLista();
    });

    function getFiltrados() {
        let filtrados = resultados;
        
        if (filtroStatus === "erros") {
            filtrados = filtrados.filter(r => r.status.includes("ERRO"));
        } else if (filtroStatus === "pendentes") {
            filtrados = filtrados.filter(r => r.status.includes("Aguardando"));
        } else if (filtroStatus === "vencidos") {
            filtrados = filtrados.filter(r => isVencido(r.fupDate));
        } else if (filtroStatus === "d3") {
            filtrados = filtrados.filter(r => r.status.includes("D+3"));
        } else if (filtroStatus === "d7") {
            filtrados = filtrados.filter(r => r.status.includes("D+7"));
        } else if (filtroStatus === "d15") {
            filtrados = filtrados.filter(r => r.status.includes("D+15"));
        } else if (filtroStatus === "d30") {
            filtrados = filtrados.filter(r => r.status.includes("D+30"));
        } else if (filtroStatus === "d60") {
            filtrados = filtrados.filter(r => r.status.includes("D+60"));
        } else if (filtroStatus === "vend") {
            filtrados = filtrados.filter(r => (r.status || "").toUpperCase().includes("VENDEDOR"));
        }
        
        if (termoBusca) {
            filtrados = filtrados.filter(r => 
                normalizar(r.ticket).includes(termoBusca) || 
                normalizar(r.titulo).includes(termoBusca) || 
                normalizar(r.status).includes(termoBusca)
            );
        }
        return filtrados;
    }

    function renderLista() {
        const listDiv = document.getElementById("fg-list");
        const filtrados = getFiltrados();
        
        atualizarResumo(); 

        if (!filtrados.length) {
            listDiv.innerHTML = '<div style="padding: 15px; color: #6b7280; font-size: 12px; text-align: center;">Nenhum resultado para os filtros atuais.</div>';
            return;
        }

        listDiv.innerHTML = filtrados.map((r) => {
            const indexOriginal = resultados.indexOf(r);
            const isSelected = selecionadoIndex === indexOriginal;
            
            let corStatus = "";
            const stUpper = (r.status || "").toUpperCase();
            
            // Ordem: FUP > VENDEDOR > OUTROS para pintar a tag
            if (stUpper.includes("ERRO")) corStatus = "st-err";
            else if (stUpper.includes("FUP") || stUpper.includes("FOLLOW UP") || stUpper.includes("D+")) corStatus = "st-fup";
            else if (stUpper.includes("VENDEDOR")) corStatus = "st-vend";
            else if (stUpper.includes("NÃO RESPONDEU") || stUpper.includes("SEM RESPOSTA")) corStatus = "st-nresp";
            else if (stUpper.includes("RESPONDEU") || stUpper.includes("POSSUI RESPOSTA")) corStatus = "st-resp";

            let labelFup = "";
            if (r.fupDate) {
                const vencido = isVencido(r.fupDate);
                labelFup = `<span class="fg-item-date ${vencido ? 'txt-overdue' : 'txt-ontime'}">📅 FUP: ${formataDataFup(r.fupDate)} ${vencido ? '(Vencido)' : ''}</span>`;
            }

            return `
                <div class="fg-item ${isSelected ? 'selected' : ''}" data-index="${indexOriginal}">
                    <div class="fg-item-ticket">${eh(r.ticket || "Sem Ticket")}</div>
                    <div class="fg-item-title">${eh(r.titulo || r.assunto)}</div>
                    <div class="fg-item-status ${corStatus}">${eh(r.status)}${labelFup}</div>
                </div>
            `;
        }).join("");

        listDiv.querySelectorAll(".fg-item").forEach(el => {
            el.onclick = () => {
                selecionadoIndex = Number(el.dataset.index);
                renderLista();
                renderDetalhe();
            };
        });
    }

    async function renderDetalhe() {
        const rightDiv = document.getElementById("fg-right");
        if (selecionadoIndex === null || !resultados[selecionadoIndex]) {
            rightDiv.innerHTML = '<div class="fg-empty">Selecione um item na lista ao lado para inspecionar os e-mails e aplicar o status.</div>';
            return;
        }

        const item = resultados[selecionadoIndex];

        let htmlFupDate = "";
        if (item.fupDate) {
            const vencido = isVencido(item.fupDate);
            htmlFupDate = `<div class="fg-status-date-info ${vencido ? 'txt-overdue' : 'txt-ontime'}">Data Limite: ${formataDataFup(item.fupDate)} ${vencido ? '⚠️ Vencido' : ''}</div>`;
        }

        rightDiv.innerHTML = `
            <div class="fg-detail-header">
                <div class="fg-detail-ticket">
                    ${eh(item.ticket || "Sem Ticket vinculado")}
                    ${item.caseId ? `<span class="fg-link-crm" id="fg-link-crm">Abrir no CRM ↗</span>` : ""}
                </div>
                <div style="font-size: 16px; color: #4b5563; margin-top: 5px;">${eh(item.titulo || "-")}</div>
                
                <div class="fg-detail-info">
                    <div class="fg-info-box"><p>Assunto do Email Original</p><div>${eh(item.assunto)}</div></div>
                    <div class="fg-info-box"><p>Email ID</p><div>${eh(item.emailId)}</div></div>
                    <div class="fg-info-box"><p>Case ID</p><div>${eh(item.caseId || "Nenhum Case associado")}</div></div>
                </div>
            </div>

            <div class="fg-actions">
                <button class="fg-btn fg-btn-neutral" id="fg-btn-abrir">VER MENSAGENS 👇</button>
                <div style="width: 1px; height: 20px; background: #d1d5db; margin: 0 5px;"></div>
                <button class="fg-btn fg-btn-success" id="fg-btn-resp">✅ RESP.</button>
                <button class="fg-btn fg-btn-danger" id="fg-btn-nao-resp">❌ NÃO RESP.</button>
                <button class="fg-btn fg-btn-vend" id="fg-btn-vend">👤 VENDEDOR</button>
                <div style="flex-grow: 1;"></div>
                <div class="fg-status-display" id="fg-status-display">
                    ${eh(item.status)}
                    ${htmlFupDate}
                </div>
                <button class="fg-btn fg-btn-primary" id="fg-btn-prox" style="margin-left: 8px;">▶ PRÓXIMO</button>
            </div>

            <!-- NOVA SEÇÃO DE FOLLOW-UP -->
            <div class="fg-templates-box">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 10px; flex-wrap: wrap; gap: 10px;">
                    <div class="fg-templates-title" style="margin-bottom:0;">Registrar Etapa e Copiar Mensagem de FUP:</div>
                    <div style="display:flex; align-items:center; gap:5px; background: #fff; padding: 4px 8px; border-radius: 6px; border: 1px solid #d1d5db;">
                        <label style="font-size: 11px; font-weight: 600; color: #4b5563; margin:0;">Data Base (Lead):</label>
                        <input type="date" id="fg-base-date" style="border:none; outline:none; font-size:11px; color:#111827; background:transparent; cursor:pointer;" title="Altere se quiser calcular a partir de outra data em vez de Hoje" />
                    </div>
                </div>
                <div class="fg-templates-buttons">
                    <button class="fg-btn-copy" data-template="d3" data-fup="⏰ FUP D+3" data-days="3">D+3 (1º FUP)</button>
                    <button class="fg-btn-copy" data-template="d7" data-fup="⏰ FUP D+7" data-days="7">D+7 (2º FUP)</button>
                    <button class="fg-btn-copy" data-template="d15" data-fup="⏰ FUP D+15" data-days="15">D+15 (3º FUP)</button>
                    <button class="fg-btn-copy" data-template="d30" data-fup="⏰ FUP D+30" data-days="30">D+30 (4º FUP)</button>
                    <button class="fg-btn-copy" data-template="d60" data-fup="⏰ FUP D+60" data-days="60">D+60 (Final)</button>
                    <button class="fg-btn-copy fg-btn-copy-vend" data-template="fupVend" data-fup="⏰ FUP Vendas" data-days="3">FUP Pós-Vendas</button>
                    <span id="fg-copy-feedback" class="fg-copy-feedback">✅ Copiado e Agendado!</span>
                </div>
            </div>

            <div class="fg-section-title" id="sec-emails">EMAILS DO CASE</div>
            <div id="fg-emails-container">
                <div style="color: #6b7280; font-size: 13px; font-style: italic;">Buscando histórico de emails...</div>
            </div>
        `;

        const linkCrm = document.getElementById("fg-link-crm");
        if (linkCrm) linkCrm.onclick = () => Xrm.Navigation.openForm({ entityName: "incident", entityId: item.caseId });

        document.getElementById("fg-btn-abrir").onclick = () => document.getElementById("sec-emails").scrollIntoView({ behavior: "smooth" });

        const updateStatus = (newStatus, addDays = null) => {
            item.status = newStatus;
            item.statusManual = true; 
            
            if (addDays !== null) {
                let baseDate = new Date();
                const inputBase = document.getElementById("fg-base-date");
                if (inputBase && inputBase.value) {
                    baseDate = new Date(inputBase.value + "T00:00:00");
                }
                baseDate.setDate(baseDate.getDate() + parseInt(addDays));
                item.fupDate = baseDate.toISOString();
            } else {
                item.fupDate = null; 
            }
            
            renderLista(); 
            renderDetalhe(); 
        };

        // Botões de Template FUP (Agora salvam a data calculada com base no input)
        document.querySelectorAll(".fg-btn-copy").forEach(btn => {
            btn.onclick = () => {
                const text = TEMPLATES_FUP[btn.dataset.template];
                const novoStatus = btn.dataset.fup;
                const daysToAdd = btn.dataset.days;
                
                navigator.clipboard.writeText(text).then(() => {
                    updateStatus(novoStatus, daysToAdd);
                    setTimeout(() => {
                        const feedback = document.getElementById("fg-copy-feedback");
                        if(feedback) {
                            feedback.style.opacity = "1";
                            setTimeout(() => feedback.style.opacity = "0", 2500);
                        }
                    }, 50);
                });
            };
        });

        document.getElementById("fg-btn-resp").onclick = () => updateStatus("✅ RESPONDEU");
        document.getElementById("fg-btn-nao-resp").onclick = () => updateStatus("❌ NÃO RESPONDEU");
        document.getElementById("fg-btn-vend").onclick = () => updateStatus("👤 COM VENDEDOR");

        document.getElementById("fg-btn-prox").onclick = () => {
            const filtrados = getFiltrados();
            const idxAtualFiltro = filtrados.findIndex(r => resultados.indexOf(r) === selecionadoIndex);
            if (idxAtualFiltro >= 0 && idxAtualFiltro < filtrados.length - 1) {
                selecionadoIndex = resultados.indexOf(filtrados[idxAtualFiltro + 1]);
                renderLista();
                renderDetalhe();
                document.getElementById("fg-right").scrollTo(0,0);
            }
        };

        const containerEmails = document.getElementById("fg-emails-container");
        if (!item.caseId) {
            containerEmails.innerHTML = `<div style="color:#b91c1c; font-size:13px; background: #fee2e2; padding: 15px; border-radius: 8px;">Sem histórico disponível.<br><br>Geralmente ocorre porque o E-mail de origem falhou ao carregar ou o GUID consultado não está atrelado a um Case (Incidente).</div>`;
            return;
        }

        try {
            const query = `?$select=activityid,subject,createdon,directioncode,description&$filter=_regardingobjectid_value eq ${guid(item.caseId)}&$orderby=createdon desc`;
            const req = await Xrm.WebApi.retrieveMultipleRecords("email", query);
            const emails = req.entities || [];

            if (!emails.length) {
                containerEmails.innerHTML = `<div style="color:#6b7280; font-size:13px;">Nenhum email encontrado neste Case.</div>`;
                return;
            }

            // Auto-preencher a Data Base com o E-mail mais antigo (Recebimento do Lead)
            const baseInput = document.getElementById("fg-base-date");
            if (baseInput && !baseInput.value) {
                const oldestEmail = emails[emails.length - 1]; 
                if (oldestEmail && oldestEmail.createdon) {
                    const dt = new Date(oldestEmail.createdon);
                    const yr = dt.getFullYear();
                    const mo = String(dt.getMonth() + 1).padStart(2, '0');
                    const da = String(dt.getDate()).padStart(2, '0');
                    baseInput.value = `${yr}-${mo}-${da}`;
                }
            }

            if (!item.statusManual && item.status === "Aguardando análise") {
                const possuiEntrada = emails.some(e => e.directioncode === false);
                item.status = possuiEntrada ? "✅ POSSUI RESPOSTA" : "❌ SEM RESPOSTA";
                document.getElementById("fg-status-display").textContent = item.status;
                renderLista();
            }

            containerEmails.innerHTML = `<div class="fg-email-list">` + emails.map((e, idx) => {
                const isSaida = e.directioncode === true;
                const badge = isSaida ? `<span class="fg-dir-out">📤 SAÍDA</span>` : `<span class="fg-dir-in">📥 ENTRADA</span>`;
                return `
                    <div class="fg-email-card" data-idx="${idx}">
                        <div class="fg-email-header">
                            <div class="fg-email-top">
                                <div class="fg-email-subject">${eh(e.subject || "(Sem Assunto)")}</div>
                                <div>${badge}</div>
                            </div>
                            <div class="fg-email-meta">${eh(dataBR(e.createdon))}</div>
                        </div>
                        <div class="fg-email-body"></div>
                    </div>
                `;
            }).join("") + `</div>`;

            // Lógica de Expandir Emails e carregar imagens inline (cid:) sob demanda
            const cards = containerEmails.querySelectorAll(".fg-email-card");
            cards.forEach((card, i) => {
                const header = card.querySelector(".fg-email-header");
                const body = card.querySelector(".fg-email-body");
                const emailData = emails[card.dataset.idx];

                header.onclick = async () => {
                    const isOpen = card.classList.contains("open");
                    if (!isOpen && !body.querySelector("iframe")) {
                        const iframe = document.createElement("iframe");
                        iframe.className = "fg-email-frame";
                        let htmlContent = emailData.description || "<p>(Corpo do email vazio)</p>";
                        
                        // Injetar CSS para responsividade e quebra de texto
                        if (!htmlContent.includes("<html")) {
                            htmlContent = `<html><head><style>body{font-family:sans-serif;font-size:14px;padding:15px; word-wrap:break-word;} img{max-width:100%; height:auto;}</style></head><body>${htmlContent}</body></html>`;
                        } else {
                            htmlContent = htmlContent.replace(/<head>/i, '<head><style>img{max-width:100%; height:auto;}</style>');
                        }
                        
                        iframe.srcdoc = htmlContent;
                        body.appendChild(iframe);

                        // Lógica de processamento e extração de imagens inline
                        if (htmlContent.includes("cid:")) {
                            const loadingBadge = document.createElement("div");
                            loadingBadge.innerHTML = "⏳ Processando imagens da mensagem...";
                            loadingBadge.style.fontSize = "11px";
                            loadingBadge.style.color = "#ff8c00";
                            loadingBadge.style.padding = "8px 15px";
                            loadingBadge.style.background = "#fffbeb";
                            loadingBadge.style.borderBottom = "1px solid #fde68a";
                            body.insertBefore(loadingBadge, iframe);
                            
                            try {
                                const reqAtt = await Xrm.WebApi.retrieveMultipleRecords("activitymimeattachment", `?$select=body,mimetype,attachmentcontentid,filename&$filter=_objectid_value eq ${emailData.activityid}`);
                                let newHtml = htmlContent;
                                
                                if (reqAtt.entities && reqAtt.entities.length > 0) {
                                    reqAtt.entities.forEach(att => {
                                        if (att.body && (att.mimetype || "").toLowerCase().startsWith("image/")) {
                                            const dataUrl = `data:${att.mimetype};base64,${att.body}`;
                                            
                                            if (att.attachmentcontentid) {
                                                const cidLimpo = String(att.attachmentcontentid).replace(/^<|>$/g, ""); 
                                                const cidRegex = new RegExp(`cid:${escapeRegExp(cidLimpo)}`, "gi");
                                                newHtml = newHtml.replace(cidRegex, dataUrl);
                                            }
                                            if (att.filename) {
                                                const cidRegex2 = new RegExp(`cid:${escapeRegExp(att.filename)}`, "gi");
                                                newHtml = newHtml.replace(cidRegex2, dataUrl);
                                            }
                                        }
                                    });
                                    iframe.srcdoc = newHtml;
                                }
                                loadingBadge.remove();
                            } catch(err) {
                                loadingBadge.innerHTML = "❌ Erro ao carregar algumas imagens da mensagem.";
                                loadingBadge.style.color = "#d13438";
                                loadingBadge.style.background = "#fef2f2";
                                loadingBadge.style.borderBottom = "1px solid #fecaca";
                            }
                        }
                    }
                    card.classList.toggle("open");
                };

                if (i === 0) header.click();
            });

        } catch (e) {
            containerEmails.innerHTML = `<div style="color:#b91c1c; font-size:13px;">Erro ao buscar emails: ${eh(e.message)}</div>`;
        }
    }

    // Botão de Fechar Total
    document.getElementById("fg-btn-fechar").onclick = () => {
        overlay.remove();
        style.remove();
        btnMinimized.remove();
    };

})();
