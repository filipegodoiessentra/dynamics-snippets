    async function enviarEmailFollowUp(item, textoCorpo) {
        const QUEUE_ID = "1dc95bff-6e36-ec11-8c64-000d3aba5426"; // CBR Sales
        let recipientEmail = "";
        
        try {
            const qEmails = `?$select=description&$filter=_regardingobjectid_value eq ${guid(item.caseId)}&$orderby=createdon desc&$top=5`;
            const reqE = await Xrm.WebApi.retrieveMultipleRecords("email", qEmails);
            const regexEmailBody = /E-mail\s*([a-zA-Z0-9._-]+@[a-zA-Z0-9._-]+\.[a-zA-Z0-9._-]+)/i;
            
            for (let em of reqE.entities) {
                let bodyLimpo = (em.description || "").replace(/<[^>]+>/g, ' ').replace(/\&nbsp;/gi, ' ');
                let mE = bodyLimpo.match(regexEmailBody);
                if (mE) {
                    recipientEmail = mE[1].trim();
                    break;
                }
            }
        } catch(e) {}

        if (!recipientEmail) {
            try {
                const inc = await Xrm.WebApi.retrieveRecord("incident", guid(item.caseId), "?$select=_customerid_value");
                if (inc._customerid_value) {
                    const customerType = inc["_customerid_value@Microsoft.Dynamics.CRM.lookuplogicalname"];
                    let leadId = null;
                    if (customerType === "lead") leadId = inc._customerid_value;
                    else {
                        const customer = await Xrm.WebApi.retrieveRecord(customerType, guid(inc._customerid_value), "?$select=_originatingleadid_value");
                        leadId = customer._originatingleadid_value;
                    }
                    if (leadId) {
                        const lead = await Xrm.WebApi.retrieveRecord("lead", guid(leadId), "?$select=emailaddress1");
                        recipientEmail = lead.emailaddress1;
                    }
                }
            } catch(e) {}
        }

        if (!recipientEmail) {
            throw new Error("Não foi possível localizar o E-mail do cliente para envio automático.");
        }

        const assunto = item.assunto.toUpperCase().startsWith("RE:") ? item.assunto : `RE: ${item.assunto}`;
        const corpoHtml = textoCorpo.replace(/\n/g, "<br>");

        const emailData = {
            subject: assunto,
            description: corpoHtml,
            "regardingobjectid_incident@odata.bind": `/incidents(${guid(item.caseId)})`,
            email_activity_parties: [
                {
                    "partyid_queue@odata.bind": `/queues(${QUEUE_ID})`,
                    participationtypemask: 1 
                },
                {
                    addressused: recipientEmail,
                    participationtypemask: 2 
                }
            ]
        };

        const novoEmail = await Xrm.WebApi.createRecord("email", emailData);

        const request = {
            entity: { entityType: "email", id: novoEmail.id },
            IssueSend: true,
            getMetadata: function () {
                return {
                    boundParameter: "entity",
                    operationType: 0,
                    operationName: "SendEmail",
                    parameterTypes: {
                        entity: { typeName: "mscrm.email", structuralProperty: 5 },
                        IssueSend: { typeName: "Edm.Boolean", structuralProperty: 1 }
                    }
                };
            }
        };

        await Xrm.WebApi.online.execute(request);
        return true;
    }

    // =========================================================
    // MOTOR DE CALL PLAN
    // =========================================================
    async function processarCallPlan(item) {
        if (!item.caseId) throw new Error("Registro sem Case vinculado.");
        if (!item.ticket || item.ticket === "-") throw new Error("Ticket inválido.");

        const callPlanName = "FUP " + item.ticket;

        const checkQuery = `?$select=cuk_callplanid&$filter=cuk_callplanname eq '${callPlanName}'`;
        const reqCheck = await Xrm.WebApi.retrieveMultipleRecords("cuk_callplan", checkQuery);
        if (reqCheck.entities && reqCheck.entities.length > 0) {
            item.callPlanId = guid(reqCheck.entities[0].cuk_callplanid);
            return "EXISTENTE";
        }

        const inc = await Xrm.WebApi.retrieveRecord("incident", guid(item.caseId), "?$select=_customerid_value,_ownerid_value");
        let leadId = null;
        
        const ownerId = inc._ownerid_value;
        const ownerType = inc["_ownerid_value@Microsoft.Dynamics.CRM.lookuplogicalname"];

        if (inc._customerid_value) {
            const customerType = inc["_customerid_value@Microsoft.Dynamics.CRM.lookuplogicalname"];
            try {
                const customer = await Xrm.WebApi.retrieveRecord(customerType, guid(inc._customerid_value), "?$select=_originatingleadid_value");
                if (customer._originatingleadid_value) leadId = customer._originatingleadid_value;
            } catch(e) {}
        }

        let leadNumber = "";
        let leadEmail = "";
        let leadPhone = "";
        let leadMessage = "";

        const regexLead = /L\d{2}-\d{7}/i;
        const regexEmailBody = /E-mail\s*([a-zA-Z0-9._-]+@[a-zA-Z0-9._-]+\.[a-zA-Z0-9._-]+)/i;
        const regexPhoneBody = /Telefone\s*([\d\s\-\(\)\+]{8,20})/i;
        const regexMessageBody = /Escreva aqui o que voc[êe] precisa[.:]?\s*(.*?)\s*(?:Referral source|Dispositivo|URL|IP do|Data de)/i;

        let matchLead = (item.assunto || "").match(regexLead) || (item.titulo || "").match(regexLead);
        if (matchLead) leadNumber = matchLead[0].toUpperCase();

        try {
            const qEmails = `?$select=subject,description&$filter=_regardingobjectid_value eq ${guid(item.caseId)}&$orderby=createdon desc&$top=10`;
            const reqE = await Xrm.WebApi.retrieveMultipleRecords("email", qEmails);
            
            for (let em of reqE.entities) {
                if (!leadNumber) {
                    let mLead = (em.subject || "").match(regexLead);
                    if (mLead) leadNumber = mLead[0].toUpperCase();
                }

                if (!leadEmail || !leadPhone || !leadMessage) {
                    let bodyLimpo = (em.description || "").replace(/<[^>]+>/g, ' ').replace(/\&nbsp;/gi, ' ').replace(/\s+/g, ' ');
                    
                    if (!leadEmail) {
                        let mE = bodyLimpo.match(regexEmailBody);
                        if (mE) leadEmail = mE[1].trim();
                    }

                    if (!leadPhone) {
                        let mP = bodyLimpo.match(regexPhoneBody);
                        if (mP) leadPhone = mP[1].trim();
                    }

                    if (!leadMessage) {
                        let parts = bodyLimpo.split(/Escreva aqui o que voc[êe] precisa[.:\s]*/i);
                        if (parts.length > 1) {
                            let textAfter = parts[parts.length - 1]; 
                            leadMessage = textAfter.split(/(?:Referral source|Dispositivo|URL|IP do|Data de)/i)[0].trim();
                        }
                    }
                }
            }
        } catch(e) {}

        if (leadId && (!leadEmail || !leadPhone || !leadNumber)) {
            try {
                const lead = await Xrm.WebApi.retrieveRecord("lead", guid(leadId), "?$select=subject,fullname,companyname,emailaddress1,telephone1,mobilephone");
                if (!leadNumber) leadNumber = lead.subject || lead.fullname || lead.companyname || "";
                if (!leadEmail) leadEmail = lead.emailaddress1 || "";
                if (!leadPhone) leadPhone = lead.mobilephone || lead.telephone1 || "";
            } catch(e) {}
        }

        const dataHoje = new Date(); 
        const anoCorrente = dataHoje.getFullYear();
        const proximoContato = new Date(dataHoje);
        proximoContato.setDate(proximoContato.getDate() + 1);

        const purposeFinal = leadNumber ? `LEAD ${leadNumber.trim()}` : "LEAD";
        
        let notasFinal = `Case Relacionado: ${item.ticket}\nE-mail do Lead: ${leadEmail || 'N/A'}\nTelefone do Lead: ${leadPhone || 'N/A'}`;
        if (leadMessage) {
            notasFinal += `\n\nO que o Lead precisa:\n${leadMessage}`;
        }

        const payload = {
            cuk_callplanname: callPlanName,
            cuk_calldatedateonly: `${anoCorrente}-01-01`, 
            cuk_nextcontactdatedateonly: formataDataAPI(proximoContato), 
            cuk_callcompleted: false,
            cuk_callpurpose: purposeFinal,
            "ess_CreatedCase@odata.bind": `/incidents(${guid(item.caseId)})` 
        };

        if (ownerId && ownerType) {
            const collection = ownerType === "team" ? "teams" : "systemusers";
            payload["ownerid@odata.bind"] = `/${collection}(${guid(ownerId)})`;
        }

        if (leadId) {
            payload["ess_OriginatingLead@odata.bind"] = `/leads(${guid(leadId)})`;
        }

        let created;
        try {
            created = await Xrm.WebApi.createRecord("cuk_callplan", payload);
        } catch (erroOriginal) {
            delete payload["ess_OriginatingLead@odata.bind"];
            created = await Xrm.WebApi.createRecord("cuk_callplan", payload);
        }

        const cpId = guid(created.id);
        item.callPlanId = cpId;

        // Auto-Discovery
        if (leadPhone) {
            let phoneSuccess = false;
            const phoneFields = ["cuk_phonenumber", "cuk_phone", "phonenumber"];
            for (let field of phoneFields) {
                if (phoneSuccess) break;
                try {
                    let up = {}; up[field] = leadPhone;
                    await Xrm.WebApi.updateRecord("cuk_callplan", cpId, up);
                    phoneSuccess = true;
                } catch(e) {}
            }
        }

        if (notasFinal) {
            let notesSuccess = false;
            const notesFields = ["cuk_callnotes", "cuk_notes", "description"];
            for (let field of notesFields) {
                if (notesSuccess) break;
                try {
                    let up = {}; up[field] = notasFinal;
                    await Xrm.WebApi.updateRecord("cuk_callplan", cpId, up);
                    notesSuccess = true;
                } catch(e) {}
            }
        }

        return "CRIADO";
    }

