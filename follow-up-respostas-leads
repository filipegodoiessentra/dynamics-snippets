    function atualizarResumo() {
        const divDash = document.getElementById("fg-dashboard");
        const groupExport = document.getElementById("fg-group-export");
        
        if (!resultados.length) {
            divDash.style.display = "none";
            groupExport.style.display = "none";
            return;
        }

        divDash.style.display = "flex";
        groupExport.style.display = "flex";

        let total = resultados.length;
        let comResposta = 0, semResposta = 0, fup = 0, vendedor = 0, vencidos = 0;

        resultados.forEach(r => {
            const st = r.status.toUpperCase();
            
            // Prioriza FUP, senão Vendedor (para a tag FUP Vendas entrar em FUP)
            if (st.includes("FUP") || st.includes("FOLLOW UP") || st.includes("D+")) {
                fup++;
                if (isVencido(r.fupDate)) vencidos++;
            }
            else if (st.includes("VENDEDOR")) vendedor++;
            else if (st.includes("NÃO RESPONDEU") || st.includes("SEM RESPOSTA")) semResposta++;
            else if (st.includes("RESPONDEU") || st.includes("POSSUI RESPOSTA")) comResposta++;
        });

        divDash.innerHTML = `
            <div class="fg-card" style="border-left: 3px solid #107c10;">
                <div class="fg-card-title">C/ Resposta</div>
                <div class="fg-card-value">${comResposta}</div>
            </div>
            <div class="fg-card" style="border-left: 3px solid #d13438;">
                <div class="fg-card-title">S/ Resposta</div>
                <div class="fg-card-value">${semResposta}</div>
            </div>
            <div class="fg-card" style="border-left: 3px solid #f59e0b;">
