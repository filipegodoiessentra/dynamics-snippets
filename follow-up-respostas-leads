(async function () {
    // 1. Limpeza prévia
    document.getElementById("fg-fup-overlay")?.remove();
    document.getElementById("fg-fup-style")?.remove();
    document.getElementById("fg-fup-minimized")?.remove();

    // 2. Variáveis de Estado
    let resultados = [];
    let selecionadoIndex = null;
    let termoBusca = "";
    let filtroStatus = "todos"; // 'todos', 'erros', 'pendentes'

    // Funções utilitárias
    const guid = s => (s || "").replace(/[{}]/g, "").toLowerCase();
    const dataBR = s => { try { return s ? new Date(s).toLocaleString("pt-BR") : "-"; } catch { return s || "-"; } };
    const eh = s => String(s ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
    const normalizar = s => (s || "").normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();

    // 3. Injeção de CSS
    const style = document.createElement("style");
    style.id = "fg-fup-style";
    style.innerHTML = `
        #fg-fup-overlay { position: fixed; inset: 0; z-index: 999998; background: rgba(0,0,0,0.5); display: flex; justify-content: center; align-items: center; font-family: "Segoe UI", Arial, sans-serif; transition: 0.3s; }
        #fg-fup-modal { width: 95vw; height: 90vh; background: #fff; border-radius: 12px; display: flex; overflow: hidden; box-shadow: 0 20px 50px rgba(0,0,0,0.3); position: relative; }
        
        #fg-btn-fechar { position: absolute; right: 15px; top: 15px; background: transparent; border: none; font-size: 24px; cursor: pointer; color: #666; z-index: 10; line-height: 1; }
        #fg-btn-fechar:hover { color: #000; }
        
        #fg-btn-minimizar { position: absolute; right: 50px; top: 5px; background: transparent; border: none; font-size: 28px; cursor: pointer; color: #666; z-index: 10; line-height: 1; font-weight: bold; }
        #fg-btn-minimizar:hover { color: #000; }
        
        #fg-fup-minimized { position: fixed; bottom: 25px; right: 25px; background: #106ebe; color: white; border: none; padding: 12px 20px; border-radius: 30px; font-family: "Segoe UI", sans-serif; font-size: 14px; font-weight: bold; cursor: pointer; z-index: 999999; box-shadow: 0 4px 15px rgba(0,0,0,0.3); display: none; align-items: center; gap: 8px; }
        #fg-fup-minimized:hover { background: #005a9e; }
        
        /* Lateral Esquerda */
        #fg-left { width: 380px; background: #f9fafb; border-right: 1px solid #e5e7eb; display: flex; flex-direction: column; padding: 15px; box-sizing: border-box; }
        .fg-left-title { font-size: 16px; font-weight: 600; margin-bottom: 10px; color: #111827; }
        #fg-guids-input { width: 100%; height: 80px; resize: none; border: 1px solid #d1d5db; border-radius: 6px; padding: 8px; font-size: 12px; box-sizing: border-box; margin-bottom: 10px; flex-shrink: 0; }
        
        .fg-btn-group { display: flex; gap: 8px; width: 100%; margin-bottom: 8px; }
        .fg-btn { padding: 8px 12px; border: none; border-radius: 6px; cursor: pointer; font-weight: 600; font-size: 12px; color: white; display: inline-flex; align-items: center; justify-content: center; gap: 5px; flex-shrink: 0; transition: 0.2s; }
        .fg-btn:hover { opacity: 0.9; }
        .fg-btn-primary { background: #106ebe; }
        .fg-btn-success { background: #107c10; }
        .fg-btn-danger { background: #d13438; }
        .fg-btn-warning { background: #ff8c00; }
        .fg-btn-neutral { background: #f3f4f6; color: #374151; border: 1px solid #d1d5db; }
        
        /* Dashboard */
        .fg-dashboard { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 10px; display: none; margin-bottom: 8px; }
        .fg-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 6px; padding: 10px; text-align: center; box-shadow: 0 1px 2px rgba(0,0,0,0.05); }
        .fg-card-title { font-size: 10px; color: #6b7280; text-transform: uppercase; margin-bottom: 5px; font-weight: 600; }
        .fg-card-value { font-size: 16px; font-weight: 700; color: #111827; display: flex; align-items: center; justify-content: center; gap: 5px; }
        .fg-card-percent { font-size: 10px; padding: 2px 5px; border-radius: 4px; }
        .fg-pct-green { background: #d1fae5; color: #047857; }
        .fg-pct-red { background: #fee2e2; color: #b91c1c; }
        .fg-pct-gray { background: #f3f4f6; color: #4b5563; }
        
        /* Filtros e Busca */
        #fg-busca { width: 100%; border: 1px solid #d1d5db; border-radius: 6px; padding: 8px; font-size: 13px; box-sizing: border-box; margin: 10px 0; flex-shrink: 0; }
        .fg-filters { display: flex; gap: 5px; margin-bottom: 10px; }
        .fg-filter-btn { padding: 4px 10px; border-radius: 12px; border: 1px solid #d1d5db; background: #fff; color: #4b5563; font-size: 11px; cursor: pointer; }
        .fg-filter-btn.active { background: #106ebe; color: #fff; border-color: #106ebe; font-weight: bold; }
        
        #fg-list { flex: 1; overflow-y: auto; background: #fff; border: 1px solid #e5e7eb; border-radius: 6px; min-height: 0; }
        .fg-item { padding: 12px; border-bottom: 1px solid #f3f4f6; cursor: pointer; }
        .fg-item:hover { background: #f9fafb; }
        .fg-item.selected { background: #eff6ff; border-left: 4px solid #106ebe; padding-left: 8px; }
        .fg-item-ticket { font-weight: 700; font-size: 13px; color: #111827; }
        .fg-item-title { font-size: 12px; color: #4b5563; margin: 4px 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .fg-item-status { font-size: 11px; font-weight: 600; color: #6b7280; }
        
        /* Painel Direito */
        #fg-right { flex: 1; display: flex; flex-direction: column; overflow-y: auto; padding: 25px; box-sizing: border-box; background: #fff; scroll-behavior: smooth; }
        .fg-empty { display: flex; flex: 1; align-items: center; justify-content: center; color: #6b7280; font-size: 15px; text-align: center; }
        
        .fg-detail-header { border-bottom: 1px solid #e5e7eb; padding-bottom: 15px; margin-bottom: 20px; }
        .fg-detail-ticket { font-size: 22px; font-weight: 700; color: #111827; display: flex; align-items: center; justify-content: space-between; }
        .fg-link-crm { font-size: 12px; color: #106ebe; text-decoration: underline; cursor: pointer; font-weight: normal; }
        .fg-detail-info { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-top: 15px; background: #f9fafb; padding: 15px; border-radius: 8px; }
        .fg-info-box p { margin: 0 0 5px 0; font-size: 12px; color: #6b7280; text-transform: uppercase; }
        .fg-info-box div { font-size: 14px; color: #111827; word-break: break-all; }
        
        .fg-actions { display: flex; gap: 8px; margin: 20px 0; flex-wrap: wrap; align-items: center; position: sticky; top: -25px; background: #fff; z-index: 5; padding: 10px 0; border-bottom: 1px solid #eee; }
        .fg-status-display { margin-left: auto; font-size: 16px; font-weight: 700; color: #111827; background: #f3f4f6; padding: 6px 12px; border-radius: 6px; }
        
        .fg-section-title { font-size: 16px; font-weight: 600; color: #111827; margin: 25px 0 15px 0; border-bottom: 2px solid #f3f4f6; padding-bottom: 5px; }
        
        /* Emails */
        .fg-email-list { display: flex; flex-direction: column; gap: 10px; }
        .fg-email-card { border: 1px solid #e5e7eb; border-radius: 8px; overflow: hidden; }
        .fg-email-header { padding: 12px 15px; background: #f9fafb; cursor: pointer; display: flex; flex-direction: column; gap: 4px; }
        .fg-email-header:hover { background: #f3f4f6; }
        .fg-email-top { display: flex; justify-content: space-between; align-items: center; }
        .fg-email-subject { font-size: 14px; font-weight: 600; color: #1f2937; }
        .fg-email-meta { font-size: 12px; color: #6b7280; }
        .fg-dir-in { color: #047857; font-weight: 700; background: #d1fae5; padding: 2px 6px; border-radius: 4px; font-size: 10px; }
        .fg-dir-out { color: #1d4ed8; font-weight: 700; background: #dbeafe; padding: 2px 6px; border-radius: 4px; font-size: 10px; }
        
        .fg-email-body { display: none; border-top: 1px solid #e5e7eb; }
        .fg-email-card.open .fg-email-body { display: block; }
        .fg-email-frame { width: 100%; height: 400px; border: none; background: #fff; display: block; }
        .fg-loading { color: #6b7280; font-size: 13px; font-style: italic; }
    `;
    document.head.appendChild(style);

    // 4. Estrutura HTML Principal
    const overlay = document.createElement("div");
    overlay.id = "fg-fup-overlay";
    overlay.innerHTML = `
        <div id="fg-fup-modal">
            <button id="fg-btn-minimizar" title="Minimizar para a bandeja">_</button>
            <button id="fg-btn-fechar" title="Fechar ferramenta">✖</button>
            
            <div id="fg-left">
                <div class="fg-left-title">Follow-Up Center</div>
                
                <textarea id="fg-guids-input" placeholder="Cole os GUIDs dos Emails aqui (um por linha)..."></textarea>
                
                <div class="fg-btn-group" id="fg-group-load">
                    <button id="fg-btn-carregar" class="fg-btn fg-btn-primary" style="flex: 1;">CARREGAR GUIDS</button>
                    <button id="fg-btn-import-json" class="fg-btn fg-btn-neutral" title="Importar backup JSON">📁 IMPORTAR JSON</button>
                    <input type="file" id="fg-file-json" accept=".json" style="display:none;" />
                </div>

                <button id="fg-btn-show-load" class="fg-btn fg-btn-neutral" style="width: 100%; display: none;">+ INSERIR GUIDS / IMPORTAR JSON</button>

                <div id="fg-dashboard" class="fg-dashboard"></div>
                
                <div class="fg-btn-group" id="fg-group-export" style="display: none;">
                    <button id="fg-btn-export-csv" class="fg-btn fg-btn-success" style="flex: 1;" title="Exportar para Excel">📥 EXCEL</button>
                    <button id="fg-btn-export-json" class="fg-btn fg-btn-neutral" style="flex: 1;" title="Salvar progresso">💾 SALVAR JSON</button>
                </div>

                <input type="text" id="fg-busca" placeholder="Buscar ticket, título ou status..." autocomplete="off"/>
                
                <div class="fg-filters" id="fg-filters">
                    <button class="fg-filter-btn active" data-filter="todos">Todos</button>
                    <button class="fg-filter-btn" data-filter="erros">❌ Apenas Erros</button>
                    <button class="fg-filter-btn" data-filter="pendentes">Aguardando</button>
                </div>

                <div id="fg-list">
                    <div style="padding: 15px; color: #6b7280; font-size: 12px; text-align: center;">Nenhum registro carregado.</div>
                </div>
            </div>
            <div id="fg-right">
                <div class="fg-empty">Selecione um item na lista ao lado para inspecionar os e-mails e aplicar o status.</div>
            </div>
        </div>
    `;
    document.body.appendChild(overlay);

    // Botão de Minimizar (Fica solto no body para sempre aparecer)
    const btnMinimized = document.createElement("button");
    btnMinimized.id = "fg-fup-minimized";
    btnMinimized.innerHTML = "📋 Restaurar Follow-Up";
    document.body.appendChild(btnMinimized);

    // Lógica de Minimizar e Restaurar
    document.getElementById("fg-btn-minimizar").onclick = () => {
        overlay.style.display = "none";
        btnMinimized.style.display = "flex";
    };

    btnMinimized.onclick = () => {
        overlay.style.display = "flex";
        btnMinimized.style.display = "none";
    };

    // Função de transição de tela
    function transicaoParaTrabalho() {
        document.getElementById("fg-guids-input").style.display = "none";
        document.getElementById("fg-group-load").style.display = "none";
        document.getElementById("fg-btn-show-load").style.display = "block";
        document.getElementById("fg-busca").value = "";
        termoBusca = "";
        
        if (resultados.length > 0) {
            selecionadoIndex = null; // reseta para nao bugar index ao importar
            renderLista();
            // Seleciona o primeiro da lista filtrada, se houver
            const itensVisiveis = getFiltrados();
            if(itensVisiveis.length > 0) {
                selecionadoIndex = resultados.indexOf(itensVisiveis[0]);
                renderDetalhe();
            } else {
                document.getElementById("fg-right").innerHTML = '<div class="fg-empty">Nenhum item corresponde ao filtro atual.</div>';
            }
        } else {
            renderLista();
        }
    }

    // Botão para voltar a inserir guids ou importar
    document.getElementById("fg-btn-show-load").onclick = () => {
        document.getElementById("fg-guids-input").style.display = "block";
        document.getElementById("fg-group-load").style.display = "flex";
        document.getElementById("fg-btn-show-load").style.display = "none";
    };

    // Lógica dos Filtros (Todos, Erros, Pendentes)
    document.querySelectorAll(".fg-filter-btn").forEach(btn => {
        btn.onclick = (e) => {
            document.querySelectorAll(".fg-filter-btn").forEach(b => b.classList.remove("active"));
            e.target.classList.add("active");
            filtroStatus = e.target.dataset.filter;
            renderLista();
        };
    });

    // Atualiza os Cards do Dashboard
    function atualizarResumo() {
        const divDash = document.getElementById("fg-dashboard");
        const groupExport = document.getElementById("fg-group-export");
        
        if (!resultados.length) {
            divDash.style.display = "none";
            groupExport.style.display = "none";
            return;
        }

        divDash.style.display = "grid";
        groupExport.style.display = "flex";

        let total = resultados.length;
        let comResposta = 0, semResposta = 0, fup = 0;

        resultados.forEach(r => {
            const st = r.status.toUpperCase();
            if (st.includes("NÃO RESPONDEU") || st.includes("SEM RESPOSTA")) {
                semResposta++;
            } else if (st.includes("RESPONDEU") || st.includes("POSSUI RESPOSTA")) {
                comResposta++;
            } else if (st.includes("FOLLOW UP")) {
                fup++;
            }
        });

        const pctResp = total > 0 ? ((comResposta / total) * 100).toFixed(0) : 0;
        const pctSemResp = total > 0 ? ((semResposta / total) * 100).toFixed(0) : 0;

        divDash.innerHTML = `
            <div class="fg-card" style="border-left: 3px solid #107c10;">
                <div class="fg-card-title">C/ Resposta</div>
                <div class="fg-card-value">${comResposta} <span class="fg-card-percent fg-pct-green">${pctResp}%</span></div>
            </div>
            <div class="fg-card" style="border-left: 3px solid #d13438;">
                <div class="fg-card-title">S/ Resposta</div>
                <div class="fg-card-value">${semResposta} <span class="fg-card-percent fg-pct-red">${pctSemResp}%</span></div>
            </div>
            <div class="fg-card" style="border-left: 3px solid #ff8c00;">
                <div class="fg-card-title">Follow Up</div>
                <div class="fg-card-value">${fup} <span class="fg-card-percent fg-pct-gray">${total > 0 ? ((fup / total) * 100).toFixed(0) : 0}%</span></div>
            </div>
            <div class="fg-card" style="border-left: 3px solid #106ebe;">
                <div class="fg-card-title">Total Processado</div>
                <div class="fg-card-value">${total}</div>
            </div>
        `;
    }

    // Lógica: EXPORTAR CSV
    document.getElementById("fg-btn-export-csv").onclick = function() {
        if (!resultados.length) return alert("Nenhum dado para exportar.");
        let csv = "Email ID Original;Case ID;Ticket;Titulo do Case;Assunto Original;Status Atual\n";
        resultados.forEach(r => {
            const limpa = s => `"${String(s || "").replace(/"/g, '""').replace(/\n/g, ' ')}"`;
            csv += [limpa(r.emailId), limpa(r.caseId), limpa(r.ticket), limpa(r.titulo), limpa(r.assunto), limpa(r.status)].join(";") + "\n";
        });
        const blob = new Blob(["\uFEFF" + csv], { type: 'text/csv;charset=utf-8;' });
        const link = document.createElement("a");
        link.href = URL.createObjectURL(blob);
        link.download = `FollowUp_Relatorio_${new Date().toISOString().slice(0, 10)}.csv`;
        document.body.appendChild(link); link.click(); document.body.removeChild(link);
    };

    // Lógica: EXPORTAR JSON (Backup do Progresso)
    document.getElementById("fg-btn-export-json").onclick = function() {
        if (!resultados.length) return alert("Nenhum dado para exportar.");
        const jsonStr = JSON.stringify(resultados, null, 2);
        const blob = new Blob([jsonStr], { type: 'application/json' });
        const link = document.createElement("a");
        link.href = URL.createObjectURL(blob);
        link.download = `FollowUp_Backup_${new Date().toISOString().slice(0, 10)}.json`;
        document.body.appendChild(link); link.click(); document.body.removeChild(link);
    };

    // Lógica: IMPORTAR JSON (Retomar Progresso)
    const btnImportarJson = document.getElementById("fg-btn-import-json");
    const inputFileJson = document.getElementById("fg-file-json");

    btnImportarJson.onclick = () => inputFileJson.click();

    inputFileJson.onchange = function(e) {
        const file = e.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = function(evt) {
            try {
                const dados = JSON.parse(evt.target.result);
                if (!Array.isArray(dados)) throw new Error("O arquivo não contém uma lista válida.");
                
                resultados = dados; 
                transicaoParaTrabalho();
                alert(`✅ Backup carregado com sucesso!\n${resultados.length} registros restaurados.`);
            } catch (err) {
                alert("Erro ao ler o arquivo JSON. Certifique-se que escolheu o arquivo correto.\nDetalhe: " + err.message);
            }
        };
        reader.readAsText(file);
        inputFileJson.value = ""; 
    };

    // Lógica: CARREGAR GUIDS DO DYNAMICS
    document.getElementById("fg-btn-carregar").onclick = async function() {
        const btn = this;
        const texto = document.getElementById("fg-guids-input").value;
        const guidsLimpos = texto.split("\n").map(x => guid(x.trim())).filter(Boolean);
        
        if (!guidsLimpos.length) return alert("Nenhum GUID válido encontrado.");
        
        btn.disabled = true;
        btn.textContent = "CARREGANDO...";
        
        resultados = [];
        selecionadoIndex = null;

        for (let i = 0; i < guidsLimpos.length; i++) {
            const emailId = guidsLimpos[i];
            try {
                const email = await Xrm.WebApi.retrieveRecord("email", emailId, "?$select=subject,_regardingobjectid_value,activityid,createdon");
                const caseId = email._regardingobjectid_value;
                let ticket = "", titulo = "";

                if (caseId) {
                    try {
                        const inc = await Xrm.WebApi.retrieveRecord("incident", guid(caseId), "?$select=ticketnumber,title");
                        ticket = inc.ticketnumber || "";
                        titulo = inc.title || "";
                    } catch (e) { console.warn("Erro ao buscar incident:", e); }
                }

                resultados.push({ emailId, caseId, assunto: email.subject || "(Sem assunto)", ticket, titulo, status: "Aguardando análise", statusManual: false });
            } catch (e) {
                resultados.push({ emailId, caseId: null, assunto: "ERRO AO LER EMAIL", ticket: "-", titulo: String(e.message), status: "❌ ERRO", statusManual: true });
            }
        }

        btn.disabled = false;
        btn.textContent = "CARREGAR GUIDS";
        
        transicaoParaTrabalho();
    };

    // Lógica de Busca por Digitação
    document.getElementById("fg-busca").addEventListener("input", function() {
        termoBusca = normalizar(this.value);
        renderLista();
    });

    // Função de Filtragem Conjunta (Texto + Botão de Aba)
    function getFiltrados() {
        let filtrados = resultados;

        // Filtro pelas abas
        if (filtroStatus === "erros") {
            filtrados = filtrados.filter(r => r.status.includes("ERRO"));
        } else if (filtroStatus === "pendentes") {
            filtrados = filtrados.filter(r => r.status.includes("Aguardando"));
        }

        // Filtro pela caixa de texto
        if (termoBusca) {
            filtrados = filtrados.filter(r => 
                normalizar(r.ticket).includes(termoBusca) || 
                normalizar(r.titulo).includes(termoBusca) || 
                normalizar(r.status).includes(termoBusca)
            );
        }

        return filtrados;
    }

    // Renderização da Lista
    function renderLista() {
        const listDiv = document.getElementById("fg-list");
        const filtrados = getFiltrados();
        
        atualizarResumo(); 

        if (!filtrados.length) {
            listDiv.innerHTML = '<div style="padding: 15px; color: #6b7280; font-size: 12px; text-align: center;">Nenhum resultado para os filtros atuais.</div>';
            return;
        }

        listDiv.innerHTML = filtrados.map((r) => {
            const indexOriginal = resultados.indexOf(r);
            const isSelected = selecionadoIndex === indexOriginal;
            return `
                <div class="fg-item ${isSelected ? 'selected' : ''}" data-index="${indexOriginal}">
                    <div class="fg-item-ticket">${eh(r.ticket || "Sem Ticket")}</div>
                    <div class="fg-item-title">${eh(r.titulo || r.assunto)}</div>
                    <div class="fg-item-status">${eh(r.status)}</div>
                </div>
            `;
        }).join("");

        listDiv.querySelectorAll(".fg-item").forEach(el => {
            el.onclick = () => {
                selecionadoIndex = Number(el.dataset.index);
                renderLista();
                renderDetalhe();
            };
        });
    }

    // Renderização do Detalhe e Histórico de Emails
    async function renderDetalhe() {
        const rightDiv = document.getElementById("fg-right");
        if (selecionadoIndex === null || !resultados[selecionadoIndex]) {
            rightDiv.innerHTML = '<div class="fg-empty">Selecione um item na lista ao lado para inspecionar os e-mails e aplicar o status.</div>';
            return;
        }

        const item = resultados[selecionadoIndex];

        rightDiv.innerHTML = `
            <div class="fg-detail-header">
                <div class="fg-detail-ticket">
                    ${eh(item.ticket || "Sem Ticket vinculado")}
                    ${item.caseId ? `<span class="fg-link-crm" id="fg-link-crm">Abrir no CRM ↗</span>` : ""}
                </div>
                <div style="font-size: 16px; color: #4b5563; margin-top: 5px;">${eh(item.titulo || "-")}</div>
                
                <div class="fg-detail-info">
                    <div class="fg-info-box"><p>Assunto do Email Original</p><div>${eh(item.assunto)}</div></div>
                    <div class="fg-info-box"><p>Email ID</p><div>${eh(item.emailId)}</div></div>
                    <div class="fg-info-box"><p>Case ID</p><div>${eh(item.caseId || "Nenhum Case associado")}</div></div>
                </div>
            </div>

            <div class="fg-actions">
                <button class="fg-btn fg-btn-neutral" id="fg-btn-abrir">VER MENSAGENS 👇</button>
                <div style="width: 1px; height: 20px; background: #d1d5db; margin: 0 5px;"></div>
                <button class="fg-btn fg-btn-success" id="fg-btn-resp">✅ RESPONDEU</button>
                <button class="fg-btn fg-btn-danger" id="fg-btn-nao-resp">❌ NÃO RESPONDEU</button>
                <button class="fg-btn fg-btn-warning" id="fg-btn-fup">⏰ FOLLOW UP</button>
                <div style="flex-grow: 1;"></div>
                <div class="fg-status-display" id="fg-status-display">${eh(item.status)}</div>
                <button class="fg-btn fg-btn-primary" id="fg-btn-prox">▶ PRÓXIMO</button>
            </div>

            <div class="fg-section-title" id="sec-emails">EMAILS DO CASE</div>
            <div id="fg-emails-container">
                <div class="fg-loading">Buscando histórico de emails...</div>
            </div>
        `;

        const linkCrm = document.getElementById("fg-link-crm");
        if (linkCrm) linkCrm.onclick = () => Xrm.Navigation.openForm({ entityName: "incident", entityId: item.caseId });

        document.getElementById("fg-btn-abrir").onclick = () => document.getElementById("sec-emails").scrollIntoView({ behavior: "smooth" });

        const updateStatus = (newStatus) => {
            item.status = newStatus;
            item.statusManual = true; 
            document.getElementById("fg-status-display").textContent = newStatus;
            renderLista(); 
        };

        document.getElementById("fg-btn-resp").onclick = () => updateStatus("✅ RESPONDEU");
        document.getElementById("fg-btn-nao-resp").onclick = () => updateStatus("❌ NÃO RESPONDEU");
        document.getElementById("fg-btn-fup").onclick = () => updateStatus("⏰ FOLLOW UP");

        document.getElementById("fg-btn-prox").onclick = () => {
            const filtrados = getFiltrados();
            const idxAtualFiltro = filtrados.findIndex(r => resultados.indexOf(r) === selecionadoIndex);
            if (idxAtualFiltro >= 0 && idxAtualFiltro < filtrados.length - 1) {
                selecionadoIndex = resultados.indexOf(filtrados[idxAtualFiltro + 1]);
                renderLista();
                renderDetalhe();
                document.getElementById("fg-right").scrollTo(0,0);
            }
        };

        const containerEmails = document.getElementById("fg-emails-container");
        if (!item.caseId) {
            containerEmails.innerHTML = `<div style="color:#b91c1c; font-size:13px; background: #fee2e2; padding: 15px; border-radius: 8px;">Sem histórico disponível.<br><br>Geralmente ocorre porque o E-mail de origem falhou ao carregar ou o GUID consultado não está atrelado a um Case (Incidente).</div>`;
            return;
        }

        try {
            const query = `?$select=activityid,subject,createdon,directioncode,description&$filter=_regardingobjectid_value eq ${guid(item.caseId)}&$orderby=createdon desc`;
            const req = await Xrm.WebApi.retrieveMultipleRecords("email", query);
            const emails = req.entities || [];

            if (!emails.length) {
                containerEmails.innerHTML = `<div style="color:#6b7280; font-size:13px;">Nenhum email encontrado neste Case.</div>`;
                return;
            }

            if (!item.statusManual && item.status === "Aguardando análise") {
                const possuiEntrada = emails.some(e => e.directioncode === false);
                item.status = possuiEntrada ? "✅ POSSUI RESPOSTA" : "❌ SEM RESPOSTA";
                document.getElementById("fg-status-display").textContent = item.status;
                renderLista();
            }

            containerEmails.innerHTML = `<div class="fg-email-list">` + emails.map((e, idx) => {
                const isSaida = e.directioncode === true;
                const badge = isSaida ? `<span class="fg-dir-out">📤 SAÍDA</span>` : `<span class="fg-dir-in">📥 ENTRADA</span>`;
                return `
                    <div class="fg-email-card" data-idx="${idx}">
                        <div class="fg-email-header">
                            <div class="fg-email-top">
                                <div class="fg-email-subject">${eh(e.subject || "(Sem Assunto)")}</div>
                                <div>${badge}</div>
                            </div>
                            <div class="fg-email-meta">${eh(dataBR(e.createdon))}</div>
                        </div>
                        <div class="fg-email-body"></div>
                    </div>
                `;
            }).join("") + `</div>`;

            const cards = containerEmails.querySelectorAll(".fg-email-card");
            cards.forEach((card, i) => {
                const header = card.querySelector(".fg-email-header");
                const body = card.querySelector(".fg-email-body");
                const emailData = emails[card.dataset.idx];

                header.onclick = () => {
                    const isOpen = card.classList.contains("open");
                    if (!isOpen && !body.innerHTML.includes("iframe")) {
                        const iframe = document.createElement("iframe");
                        iframe.className = "fg-email-frame";
                        let htmlContent = emailData.description || "<p>(Corpo do email vazio)</p>";
                        if (!htmlContent.includes("<html")) {
                            htmlContent = `<html><head><style>body{font-family:sans-serif;font-size:14px;padding:15px;}</style></head><body>${htmlContent}</body></html>`;
                        }
                        iframe.srcdoc = htmlContent;
                        body.appendChild(iframe);
                    }
                    card.classList.toggle("open");
                };

                // Auto-expande o primeiro email
                if (i === 0) header.click();
            });

        } catch (e) {
            containerEmails.innerHTML = `<div style="color:#b91c1c; font-size:13px;">Erro ao buscar emails: ${eh(e.message)}</div>`;
        }
    }

    // Botão de Fechar Total
    document.getElementById("fg-btn-fechar").onclick = () => {
        overlay.remove();
        style.remove();
        btnMinimized.remove();
    };

})();
