                <div class="fg-card-value">${total}</div>
            </div>
        `;
    }

    document.getElementById("fg-btn-export-csv").onclick = function() {
        if (!resultados.length) return alert("Nenhum dado para exportar.");
        let csv = "Email ID Original;Case ID;Ticket;Titulo do Case;Assunto Original;Status Atual;Data Limite FUP\n";
        resultados.forEach(r => {
            const limpa = s => `"${String(s || "").replace(/"/g, '""').replace(/\n/g, ' ')}"`;
            const dataFupStr = formataDataFup(r.fupDate);
            csv += [limpa(r.emailId), limpa(r.caseId), limpa(r.ticket), limpa(r.titulo), limpa(r.assunto), limpa(r.status), limpa(dataFupStr)].join(";") + "\n";
        });
        const blob = new Blob(["\uFEFF" + csv], { type: 'text/csv;charset=utf-8;' });
        const link = document.createElement("a");
        link.href = URL.createObjectURL(blob);
        link.download = `FollowUp_Relatorio_${new Date().toISOString().slice(0, 10)}.csv`;
        document.body.appendChild(link); link.click(); document.body.removeChild(link);
    };

    document.getElementById("fg-btn-export-json").onclick = function() {
