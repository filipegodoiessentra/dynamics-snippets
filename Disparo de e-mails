const delay = (ms) => new Promise(resolve => setTimeout(resolve, ms));

// Função para definir Bom dia, Boa tarde ou Boa noite
function obterSaudacao() {
    const horaAtual = new Date().getHours();
    if (horaAtual < 12) return "bom dia";
    if (horaAtual < 18) return "boa tarde";
    return "boa noite";
}

async function enviarEmailDinamico(destinatario, assunto, corpo) {
    try {
        const emailData = {
            subject: assunto,
            description: corpo,
            "email_activity_parties": [
                {
                    "partyid_queue@odata.bind": "/queues(1dc95bff-6e36-ec11-8c64-000d3aba5426)",
                    "participationtypemask": 1 
                },
                {
                    "addressused": destinatario,
                    "participationtypemask": 2 
                }
            ]
        };

        const novoEmail = await Xrm.WebApi.createRecord("email", emailData);
        
        const request = {
            entity: { entityType: "email", id: novoEmail.id },
            IssueSend: true,
            getMetadata: function () {
                return {
                    boundParameter: "entity",
                    operationType: 0,
                    operationName: "SendEmail",
                    parameterTypes: {
                        entity: { typeName: "mscrm.email", structuralProperty: 5 },
                        IssueSend: { typeName: "Edm.Boolean", structuralProperty: 1 }
                    }
                };
            }
        };

        await Xrm.WebApi.online.execute(request);
        console.log(`✅ Enviado para: ${destinatario}`);

    } catch (erro) {
        console.error(`❌ Erro ao enviar para ${destinatario}:`, erro.message);
    }
}

async function dispararLote(lista) {
    console.log(`🚀 Iniciando o disparo de ${lista.length} e-mails...`);
    
    // Captura a saudação exata no momento em que o código roda
    const saudacao = obterSaudacao();
    
    for (let i = 0; i < lista.length; i++) {
        const destinatario = lista[i].EMAIL_DESTINO;
        const assunto = lista[i].TITULO_DO_EMAIL;
        
        // 1. Substitui o Nome
        // 2. Substitui a Saudação
        // 3. Converte as quebras de linha (\n) do JSON para quebras HTML (<br>)
        const corpoFormatado = lista[i].TEXTO
            .replaceAll("{{NOME}}", lista[i].NOME_CLIENTE)
            .replaceAll("{{SAUDACAO}}", saudacao)
            .replace(/\n/g, "<br>");
        
        await enviarEmailDinamico(destinatario, assunto, corpoFormatado);
        await delay(500); 
    }
    
    console.log("🏁 Disparo em lote finalizado com sucesso!");
}

async function carregarEEnviar(urlRaw) {
    try {
        console.log("📥 Baixando dados do GitHub...");
        const resposta = await fetch(urlRaw);
        
        if (!resposta.ok) throw new Error("Falha ao acessar o link RAW.");
        
        const listaDeEmails = await resposta.json();
        console.log(`✅ Arquivo lido! ${listaDeEmails.length} registros encontrados.`);
        
        await dispararLote(listaDeEmails);
        
    } catch (erro) {
        console.error("❌ Erro ao baixar ou ler o JSON:", erro.message);
    }
}

