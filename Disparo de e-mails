/**
 * Cria e envia um e-mail pelo Dynamics 365.
 *
 * Lógica original preservada.
 */
async function enviarEmailDinamico(
    destinatario,
    assunto,
    corpo
) {
    try {
        const emailData = {
            subject: assunto,
            description: corpo,

            email_activity_parties: [
                {
                    "partyid_queue@odata.bind":
                        `/queues(${ID_QUEUE})`,
                    participationtypemask: 1
                },
                {
                    addressused: destinatario,
                    participationtypemask: 2
                }
            ]
        };

        const novoEmail = await Xrm.WebApi.createRecord(
            "email",
            emailData
        );

        const request = {
            entity: {
                entityType: "email",
                id: novoEmail.id
            },

            IssueSend: true,

            getMetadata: function () {
                return {
                    boundParameter: "entity",
                    operationType: 0,
                    operationName: "SendEmail",

                    parameterTypes: {
                        entity: {
                            typeName: "mscrm.email",
                            structuralProperty: 5
                        },

                        IssueSend: {
                            typeName: "Edm.Boolean",
                            structuralProperty: 1
                        }
                    }
                };
            }
        };

        await Xrm.WebApi.online.execute(request);

        return {
            sucesso: true,
            emailId: novoEmail.id
        };

    } catch (erro) {
        return {
            sucesso: false,
            erro: obterMensagemErro(erro)
        };
    }
}

/**
 * Envia todos os e-mails da planilha.
 *
 * Neste ponto a planilha já passou pela pré-validação,
 * mas as checagens obrigatórias são mantidas como
 * rede de segurança.
 *
 * Sem retry automático e sem paralelismo.
 */
async function dispararLote(lista) {
    const total = lista.length;
    const saudacao = obterSaudacao();

    const falhas = [];
    const sucessos = [];

    const inicio = performance.now();

    console.log("========================================");
    console.log("🚀 INÍCIO DO DISPARO DE E-MAILS");
    console.log("========================================");
    console.log(`📊 Total de registros encontrados: ${total}`);
    console.log(`🕒 Saudação utilizada: ${saudacao}`);
    console.log("");

    for (let i = 0; i < total; i++) {
        const linha = lista[i];

        const numeroAtual = i + 1;
        const numeroLinhaExcel = i + 2;

        /**
         * Utiliza exatamente a mesma função
         * utilizada pela pré-validação e pelo popup.
         */
        const email = montarEmailDaLinha(linha, saudacao);

        const {
            id,
            destinatario,
            tituloBase,
            corpoBase,
            chave,
            assunto,
            corpo,
            variaveisNaoEncontradas
        } = email;

        // Rede de segurança (não deveria ocorrer após a pré-validação).
        const camposAusentes = [];

        if (!destinatario) {
            camposAusentes.push("EMAIL");
        }

        if (!tituloBase) {
            camposAusentes.push("TITULO DO EMAIL");
        }

        if (!id) {
            camposAusentes.push("ID");
        }

        if (!corpoBase) {
            camposAusentes.push("TEXTO");
        }

        const motivosBloqueio = [];

        if (camposAusentes.length > 0) {
            motivosBloqueio.push(
                "Campos obrigatórios ausentes: " +
                camposAusentes.join(", ")
            );
        }

        if (destinatario && !emailPareceValido(destinatario)) {
            motivosBloqueio.push("EMAIL inválido");
        }

        if (variaveisNaoEncontradas.length > 0) {
            motivosBloqueio.push(
                "Variáveis não encontradas: " +
                variaveisNaoEncontradas.join(", ")
            );
        }

        if (motivosBloqueio.length > 0) {
            const mensagemErro = motivosBloqueio.join(" | ");

            console.warn(
                `⚠️ [${numeroAtual}/${total}] ` +
                `Linha ${numeroLinhaExcel} ignorada: ` +
                mensagemErro
            );

            falhas.push({
                numero: numeroAtual,
                linhaExcel: numeroLinhaExcel,
                destinatario,
                id,
                chave,
                assunto,
                erro: mensagemErro
            });

            continue;
        }

        console.log(
            `⏳ [${numeroAtual}/${total}] ` +
            `Enviando para ${destinatario}...`
        );

        const resultadoEnvio = await enviarEmailDinamico(
            destinatario,
            assunto,
            corpo
        );

        if (resultadoEnvio.sucesso) {
            sucessos.push({
                numero: numeroAtual,
                linhaExcel: numeroLinhaExcel,
                destinatario,
                id,
                chave,
                emailId: resultadoEnvio.emailId
            });

            console.log(
                `✅ [${numeroAtual}/${total}] ` +
                `Enviado para: ${destinatario} | ` +
                `ID: ${id}`
            );

        } else {
            falhas.push({
                numero: numeroAtual,
                linhaExcel: numeroLinhaExcel,
                destinatario,
                id,
                chave,
                assunto,
                erro: resultadoEnvio.erro
            });

            console.error(
                `❌ [${numeroAtual}/${total}] ` +
                `Falha para: ${destinatario} | ` +
                `${resultadoEnvio.erro}`
            );
        }

        if (i < total - 1) {
            await delay(INTERVALO_ENTRE_EMAILS);
        }
    }

    const fim = performance.now();
    const tempoTotal = fim - inicio;

    console.log("");
    console.log("========================================");
    console.log("🏁 DISPARO FINALIZADO");
    console.log("========================================");
    console.log(`📊 Total de registros: ${total}`);

    console.log(
        `✅ Enviados com sucesso: ${sucessos.length}/${total}`
    );

    console.log(
        `❌ Falhas ou ignorados: ${falhas.length}/${total}`
    );

    console.log(
        `⏱️ Tempo total: ${formatarTempo(tempoTotal)}`
    );

    if (falhas.length > 0) {
        console.log("");

        console.warn(
            "📋 E-MAILS QUE FALHARAM OU FORAM IGNORADOS:"
        );

        console.table(falhas);

    } else {
        console.log("");
        console.log("🎉 Nenhum e-mail apresentou falha.");
    }

    return {
        total,
        sucessos,
        falhas,
        tempoTotalMilliseconds: tempoTotal,
        tempoTotalFormatado: formatarTempo(tempoTotal)
    };
}

/**
 * Valida se os cabeçalhos obrigatórios existem na planilha.
 */
function validarCabecalhos(lista) {
    if (!lista || lista.length === 0) {
        return {
            valido: false,
            ausentes: [],
            mensagem: "A planilha não possui registros."
        };
    }

    const primeiraLinha = lista[0];
    const cabecalhosEncontrados = Object.keys(primeiraLinha);

    const camposObrigatorios = [
        "ID",
        "EMAIL",
        "TITULO DO EMAIL",
        "TEXTO"
    ];

    const camposAusentes =
        camposObrigatorios.filter(campo => {
            const existe =
                cabecalhosEncontrados.some(cabecalho => {
                    return (
                        normalizarCabecalho(cabecalho) ===
                        normalizarCabecalho(campo)
                    );
                });

            return !existe;
        });

    if (camposAusentes.length > 0) {
        return {
            valido: false,
            ausentes: camposAusentes,

            mensagem:
                `Cabeçalhos obrigatórios não encontrados: ` +
                camposAusentes.join(", ")
        };
    }

    return {
        valido: true,
        ausentes: [],
        mensagem: "Cabeçalhos válidos."
    };
}

/**
 * Carrega a biblioteca XLSX e abre
 * o seletor de arquivos.
 */
function carregarExcelLocal() {
    if (typeof XLSX !== "undefined") {
        abrirSeletorExcel();
        return;
    }

    const scriptExistente = document.querySelector(
        'script[src*="xlsx.full.min.js"]'
    );

    if (scriptExistente) {
        abrirSeletorExcel();
        return;
    }

    const script = document.createElement("script");

    script.src =
        "https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js";

    script.onload = () => {
        console.log("✅ Biblioteca XLSX carregada.");
        abrirSeletorExcel();
    };

    script.onerror = () => {
        console.error(
            "❌ Não foi possível carregar " +
            "a biblioteca XLSX."
        );
    };

    document.head.appendChild(script);
}

/**
 * Abre o seletor de arquivo Excel.
 */
function abrirSeletorExcel() {
    const input = document.createElement("input");

    input.type = "file";
    input.accept = ".xlsx,.xls";
    input.style.display = "none";

    input.addEventListener("change", evento => {
        const arquivo = evento.target.files?.[0];

        if (!arquivo) {
            console.warn("⚠️ Nenhum arquivo selecionado.");
            return;
        }

        lerArquivoExcel(arquivo);
    });

    document.body.appendChild(input);
    input.click();

    setTimeout(() => {
        input.remove();
    }, 1000);
}

/**
 * Lê e processa o arquivo Excel.
 */
function lerArquivoExcel(arquivo) {
    const leitor = new FileReader();

    console.log(`📥 Lendo planilha: ${arquivo.name}`);

    leitor.onload = async evento => {
        try {
            const data = new Uint8Array(evento.target.result);

            const workbook = XLSX.read(data, {
                type: "array"
            });

            if (!workbook.SheetNames.length) {
                throw new Error(
                    "Nenhuma aba foi encontrada na planilha."
                );
            }

            const primeiraAba = workbook.SheetNames[0];
            const planilha = workbook.Sheets[primeiraAba];

            const listaDeEmails = XLSX.utils.sheet_to_json(
                planilha,
                {
                    defval: "",
                    raw: false
                }
            );

            if (!listaDeEmails.length) {
                throw new Error(
                    "A primeira aba da planilha " +
                    "não possui registros."
                );
            }

            console.log(
                `✅ Excel lido com sucesso! ` +
                `${listaDeEmails.length} registros encontrados.`
            );

            console.log(
                "📌 Cabeçalhos encontrados:",
                Object.keys(listaDeEmails[0])
            );

            /**
             * =========================================
             * ETAPA 1: VALIDAÇÃO DE CABEÇALHOS
             * =========================================
             */
            const validacao = validarCabecalhos(listaDeEmails);

            if (!validacao.valido) {
                console.error(`❌ ${validacao.mensagem}`);

                await mostrarErrosPreValidacao({
                    total: listaDeEmails.length,
                    validos: 0,
                    invalidos: listaDeEmails.length,
                    problemas: [
                        {
                            linhaExcel: 1,
                            destinatario: "Cabeçalho da planilha",
                            erro: validacao.mensagem
                        }
                    ]
                });

                return;
            }

            console.log("✅ Cabeçalhos obrigatórios validados.");

            /**
             * =========================================
             * ETAPA 2: PRÉ-VALIDAÇÃO DE TODAS AS LINHAS
             * =========================================
             *
             * NENHUM e-mail é enviado nesta etapa.
             */
            console.log("");
            console.log("🔎 Pré-validando todos os registros...");

            const preValidacao = preValidarPlanilha(listaDeEmails);

            console.log(
                `📊 Analisados: ${preValidacao.total} | ` +
                `Válidos: ${preValidacao.validos} | ` +
                `Com problemas: ${preValidacao.invalidos}`
            );

            if (!preValidacao.valido) {
                console.error("");
                console.error(
                    "❌ PLANILHA COM PROBLEMAS — DISPARO BLOQUEADO."
                );
                console.error("📭 Nenhum e-mail foi enviado.");
                console.table(preValidacao.problemas);

                await mostrarErrosPreValidacao(preValidacao);

                return;
            }

            console.log("✅ Todos os registros são válidos.");

            /**
             * =========================================
             * ETAPA 3: PREVIEW DO PRIMEIRO EMAIL
             * =========================================
             *
             * O primeiro registro NÃO é removido da lista.
             */
            const usuarioConfirmou = await mostrarPreviewDisparo(
                listaDeEmails
            );

            if (!usuarioConfirmou) {
                console.log("");
                console.log("🛑 Disparo cancelado pelo usuário.");
                console.log("📭 Nenhum e-mail foi enviado.");
                return;
            }

            console.log("");
            console.log("✅ Disparo confirmado pelo usuário.");

            /**
             * =========================================
             * ETAPA 4: ENVIO REAL (sequencial, sem retry)
             * =========================================
             */
            const resultado = await dispararLote(listaDeEmails);

            /**
             * =========================================
             * ETAPA 5: POPUP DE FINALIZAÇÃO
             * =========================================
             */
            await mostrarResultadoFinal(resultado);

        } catch (erro) {
            console.error(
                "❌ Falha ao processar o Excel:",
                obterMensagemErro(erro)
            );
        }
    };

    leitor.onerror = () => {
        console.error(
            "❌ Não foi possível ler o arquivo Excel."
        );
    };

    leitor.readAsArrayBuffer(arquivo);
}

