 */
function mostrarResultadoFinal(resultado) {
    const {
        total,
        sucessos,
        falhas,
        tempoTotalFormatado
    } = resultado;

    return new Promise(resolve => {
        const houveFalhas = falhas.length > 0;

        const { overlay, modal } = criarEstruturaModal("620px");

        const header = criarCabecalhoModal(
            houveFalhas
                ? "⚠️ Disparo finalizado com ocorrências"
                : "✅ Disparo finalizado com sucesso",
            houveFalhas
                ? "O processamento terminou, mas alguns registros apresentaram problemas."
                : "Todos os registros foram processados.",
            houveFalhas
                ? { fundo: "#ffb900", texto: "#242424" }
                : { fundo: "#107c10", texto: "#ffffff" }
        );

        const conteudo = criarConteudoModal();

        // Indicadores.
        const resumo = document.createElement("div");

        Object.assign(resumo.style, {
            display: "grid",
            gridTemplateColumns: "1fr 1fr",
            gap: "12px",
            marginBottom: "22px"
        });

        resumo.appendChild(
            criarIndicador("TOTAL PROCESSADO", total, "#9B0047")
        );

        resumo.appendChild(
            criarIndicador("ENVIADOS", sucessos.length, "#107c10")
        );

        resumo.appendChild(
            criarIndicador(
                "FALHAS / IGNORADOS",
                falhas.length,
                houveFalhas ? "#d13438" : "#107c10"
            )
        );

        resumo.appendChild(
            criarIndicador(
