/**
 * Retorna uma saudação de acordo com o horário atual.
 */
function obterSaudacao() {
    const horaAtual = new Date().getHours();

    if (horaAtual < 12) {
        return "bom dia";
    }

    if (horaAtual < 18) {
        return "boa tarde";
    }

    return "boa noite";
}

/**
 * Normaliza o nome do cabeçalho.
 *
 * Exemplos:
 * "NOME DO VENDEDOR" -> "NOME_DO_VENDEDOR"
 * "Nome do Vendedor" -> "NOME_DO_VENDEDOR"
 * "COTAÇÃO" -> "COTACAO"
 * "E-mail" -> "E_MAIL"
 */
function normalizarCabecalho(valor) {
    return String(valor ?? "")
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .trim()
        .toUpperCase()
        .replace(/[^A-Z0-9]+/g, "_")
        .replace(/^_+|_+$/g, "");
}

/**
 * Remove underscores para aceitar também placeholders como:
 *
 * {{NOME_DO_VENDEDOR}}
 * {{NOME DO VENDEDOR}}
 * {{NOMEDOVENDEDOR}}
 */
function criarChaveCompacta(valor) {
    return normalizarCabecalho(valor).replace(/_/g, "");
}

/**
 * Cria um mapa com os dados da linha.
 *
 * O mapa é criado UMA única vez por linha
 * dentro de montarEmailDaLinha() e reutilizado
 * por todas as leituras de campo daquela linha.
 */
function criarMapaDaLinha(linha) {
    const mapa = {};

    Object.entries(linha ?? {}).forEach(([cabecalho, valor]) => {
        const chaveNormalizada = normalizarCabecalho(cabecalho);
        const chaveCompacta = criarChaveCompacta(cabecalho);

        if (!chaveNormalizada) {
            return;
        }

        const valorTratado = valor ?? "";

        mapa[chaveNormalizada] = valorTratado;

        if (chaveCompacta) {
            mapa[chaveCompacta] = valorTratado;
        }
    });

    return mapa;
}

/**
 * Obtém um valor a partir de um mapa já criado.
 */
function obterCampoDoMapa(mapa, nomeCampo) {
    const chaveNormalizada = normalizarCabecalho(nomeCampo);
    const chaveCompacta = criarChaveCompacta(nomeCampo);

    if (Object.prototype.hasOwnProperty.call(mapa, chaveNormalizada)) {
        return mapa[chaveNormalizada];
    }

    if (Object.prototype.hasOwnProperty.call(mapa, chaveCompacta)) {
        return mapa[chaveCompacta];
    }

    return "";
}

/**
 * Obtém um valor da linha usando o nome do cabeçalho.
 *
 * Mantida para compatibilidade com qualquer uso avulso.
 * Internamente delega para obterCampoDoMapa().
 */
function obterCampo(linha, nomeCampo) {
    return obterCampoDoMapa(criarMapaDaLinha(linha), nomeCampo);
}

/**
 * Substitui placeholders usando um mapa já criado.
 */
function substituirVariaveisComMapa(texto, mapaOriginal, variaveisExtras = {}) {
    const mapa = Object.assign({}, mapaOriginal);
    const variaveisNaoEncontradas = new Set();

    Object.entries(variaveisExtras).forEach(([nome, valor]) => {
        const chaveNormalizada = normalizarCabecalho(nome);
        const chaveCompacta = criarChaveCompacta(nome);

        if (chaveNormalizada) {
            mapa[chaveNormalizada] = valor ?? "";
        }

        if (chaveCompacta) {
            mapa[chaveCompacta] = valor ?? "";
        }
    });

    const textoOriginal = String(texto ?? "");

    const textoFinal = textoOriginal.replace(
        /\{\{\s*([^{}]+?)\s*\}\}/g,
        (placeholderOriginal, nomeVariavel) => {
            const chaveNormalizada = normalizarCabecalho(nomeVariavel);
            const chaveCompacta = criarChaveCompacta(nomeVariavel);

            if (
                Object.prototype.hasOwnProperty.call(
                    mapa,
                    chaveNormalizada
                )
            ) {
                return String(mapa[chaveNormalizada]);
            }

            if (
                Object.prototype.hasOwnProperty.call(
                    mapa,
                    chaveCompacta
                )
            ) {
                return String(mapa[chaveCompacta]);
            }

            variaveisNaoEncontradas.add(placeholderOriginal);

            return placeholderOriginal;
        }
    );

    return {
        texto: textoFinal,
        variaveisNaoEncontradas: Array.from(variaveisNaoEncontradas)
    };
}

/**
 * Substitui placeholders dinamicamente.
 *
 * Exemplos:
 * {{NOME}}
 * {{NOME DO VENDEDOR}}
 * {{NOME_DO_VENDEDOR}}
 * {{COTAÇÃO}}
 * {{COTACAO_COMPLETA}}
 * {{SAUDACAO}}
 * {{CHAVE}}
 */
function substituirVariaveis(texto, linha, variaveisExtras = {}) {
    return substituirVariaveisComMapa(
        texto,
        criarMapaDaLinha(linha),
        variaveisExtras
    );
}

/**
 * Converte quebras de linha em HTML.
 */
function converterParaHtml(texto) {
    return String(texto ?? "")
        .replace(/\r\n/g, "\n")
        .replace(/\r/g, "\n")
        .replace(/\n/g, "<br>");
}

/**
 * Verificação básica de formato de e-mail.
 *
 * Objetivo: pegar erros humanos comuns da planilha.
 * Não pretende implementar a RFC completa.
 *
 * Inválidos:
 * "abc"
 * "fulano@"
 * "@empresa.com"
 * "email sem dominio"
 * "fulano@empresa"
 */
function emailPareceValido(email) {
    const valor = String(email ?? "").trim();

    if (!valor) {
        return false;
    }

    // Não aceita espaços, vírgulas ou ponto e vírgula
    // (evita várias pessoas na mesma célula).
    if (/[\s,;]/.test(valor)) {
        return false;
    }

    // Exatamente um "@".
    if (valor.split("@").length !== 2) {
        return false;
    }

    const [usuario, dominio] = valor.split("@");

    if (!usuario || !dominio) {
        return false;
    }

    // O domínio precisa ter ponto e um sufixo com 2+ letras.
    if (!/^[^.].*\.[A-Za-z]{2,}$/.test(dominio)) {
        return false;
    }

    // Sem pontos duplicados ou nas pontas.
    if (/\.\./.test(valor) || /^\./.test(usuario) || /\.$/.test(usuario)) {
        return false;
    }

    return /^[A-Za-z0-9._%+\-']+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}$/.test(valor);
}

/**
 * Formata milissegundos em horas, minutos e segundos.
 */
function formatarTempo(milliseconds) {
    const totalSegundos = Math.floor(milliseconds / 1000);

    const horas = Math.floor(totalSegundos / 3600);
    const minutos = Math.floor((totalSegundos % 3600) / 60);
    const segundos = totalSegundos % 60;

    const partes = [];

    if (horas > 0) {
        partes.push(`${horas}h`);
    }

    if (minutos > 0 || horas > 0) {
        partes.push(`${minutos}m`);
    }

    partes.push(`${segundos}s`);

    return partes.join(" ");
}

/**
 * Obtém a mensagem de erro de diferentes formatos retornados pelo Dataverse.
 */
function obterMensagemErro(erro) {
    if (!erro) {
        return "Erro desconhecido";
    }

    if (typeof erro === "string") {
        return erro;
    }

    if (erro.message) {
        return erro.message;
    }

    if (erro.error && erro.error.message) {
        return erro.error.message;
    }

    try {
        return JSON.stringify(erro);
    } catch {
        return String(erro);
    }
}

/**
 * Monta os dados finais de um e-mail.
 *
 * FONTE ÚNICA de composição do e-mail.
 *
 * Usada pela pré-validação, pelo preview
 * e pelo disparo real, garantindo que o que
 * aparece no popup é exatamente o que será enviado.
 */
function montarEmailDaLinha(linha, saudacao) {
    // O mapa da linha é criado UMA vez e reutilizado.
    const mapa = criarMapaDaLinha(linha);

    const id = String(obterCampoDoMapa(mapa, "ID") ?? "").trim();
    const csal = String(obterCampoDoMapa(mapa, "CSAL") ?? "").trim();
    const nCotacao = String(obterCampoDoMapa(mapa, "NCOTAÇÃO") ?? "").trim();
    const destinatario = String(obterCampoDoMapa(mapa, "EMAIL") ?? "").trim();
    const tituloBase = String(obterCampoDoMapa(mapa, "TITULO DO EMAIL") ?? "").trim();
    const corpoBase = obterCampoDoMapa(mapa, "TEXTO");
    const chave = String(obterCampoDoMapa(mapa, "CHAVE") ?? "").trim();

   let assuntoDinamico = `${tituloBase}`;

if (nCotacao) {
    assuntoDinamico += ` ${nCotacao}`;
}

if (id) {
    assuntoDinamico += ` - ${id}`;
}

if (csal) {
    assuntoDinamico += ` - ${csal}`;
}

assuntoDinamico = assuntoDinamico.trim();

    const resultadoSubstituicao = substituirVariaveisComMapa(
        corpoBase,
        mapa,
        {
            SAUDACAO: saudacao
        }
    );

    const corpoFormatado = converterParaHtml(
        resultadoSubstituicao.texto
    );

    return {
        id,
        csal,
        nCotacao,
        destinatario,
        tituloBase,
        corpoBase: String(corpoBase ?? "").trim(),
        chave,
        assunto: assuntoDinamico,
        corpo: corpoFormatado,
        variaveisNaoEncontradas:
            resultadoSubstituicao.variaveisNaoEncontradas
    };
}

/**
 * =========================================================
 * PRÉ-VALIDAÇÃO DE TODA A PLANILHA
 * =========================================================
 *
 * Percorre TODOS os registros antes de qualquer envio.
 * Nenhum e-mail é enviado nesta etapa.
 */
function preValidarPlanilha(lista) {
    const saudacao = obterSaudacao();
    const problemas = [];
    const linhasComProblema = new Set();

    lista.forEach((linha, indice) => {
        const numeroLinhaExcel = indice + 2;

        // Mesma função usada no preview e no disparo.
        const email = montarEmailDaLinha(linha, saudacao);

        const registrarProblema = (mensagem) => {
            linhasComProblema.add(numeroLinhaExcel);

            problemas.push({
                linhaExcel: numeroLinhaExcel,
                destinatario: email.destinatario || "Sem e-mail",
                id: email.id || "",
                chave: email.chave || "",
                erro: mensagem
            });
        };

        // Campos obrigatórios.
        if (!email.id) {
            registrarProblema("Campo obrigatório ID ausente");
        }

        if (!email.tituloBase) {
            registrarProblema(
                "Campo obrigatório TITULO DO EMAIL ausente"
            );
        }

        if (!email.corpoBase) {
            registrarProblema("Campo obrigatório TEXTO ausente");
        }

        if (!email.destinatario) {
            registrarProblema("Campo obrigatório EMAIL ausente");
        } else if (!emailPareceValido(email.destinatario)) {
            registrarProblema("EMAIL inválido");
        }

        // Placeholders sem correspondência bloqueiam a linha.
        if (email.variaveisNaoEncontradas.length > 0) {
            registrarProblema(
                "Variáveis não encontradas: " +
                email.variaveisNaoEncontradas.join(", ")
            );
        }

        // Placeholder malformado, ex.: "{{NOME" ou "NOME}}".
        const textoOriginal = String(email.corpoBase ?? "");
        const semPlaceholders = textoOriginal.replace(
            /\{\{\s*[^{}]+?\s*\}\}/g,
            ""
        );

        if (/\{\{|\}\}/.test(semPlaceholders)) {
            registrarProblema(
                "Placeholder malformado no TEXTO " +
                "(chaves {{ }} desbalanceadas)"
            );
        }
    });

    const total = lista.length;
    const invalidos = linhasComProblema.size;

    return {
        valido: problemas.length === 0,
        total,
        validos: total - invalidos,
        invalidos,
        problemas
    };
}

/**
 * Cria a estrutura base de um modal (overlay + caixa).
 */
function criarEstruturaModal(largura) {
    const overlay = document.createElement("div");

    Object.assign(overlay.style, {
        position: "fixed",
        top: "0",
        left: "0",
        width: "100%",
        height: "100%",
        background: "rgba(0, 0, 0, 0.55)",
        zIndex: "999999",
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
        padding: "20px",
        boxSizing: "border-box"
    });

    const modal = document.createElement("div");

    Object.assign(modal.style, {
        width: largura,
        maxWidth: "95%",
        maxHeight: "90vh",
        background: "#ffffff",
        borderRadius: "12px",
        boxShadow: "0 20px 60px rgba(0, 0, 0, 0.30)",
        fontFamily: "'Segoe UI', Arial, sans-serif",
        overflow: "hidden",
        display: "flex",
        flexDirection: "column"
    });

    overlay.appendChild(modal);

    return { overlay, modal };
}

/**
 * Cria o cabeçalho colorido de um modal.
 *
 * Usa textContent, nunca innerHTML.
 */
function criarCabecalhoModal(textoTitulo, textoSubtitulo, cores) {
    const header = document.createElement("div");

    Object.assign(header.style, {
        padding: "22px 24px",
        background: cores.fundo,
        color: cores.texto
    });

    const titulo = document.createElement("div");

    titulo.textContent = textoTitulo;

    Object.assign(titulo.style, {
        fontSize: "21px",
        fontWeight: "600"
    });

    const subtitulo = document.createElement("div");

    subtitulo.textContent = textoSubtitulo;

    Object.assign(subtitulo.style, {
        fontSize: "13px",
        marginTop: "6px",
        opacity: "0.9"
    });

    header.appendChild(titulo);
    header.appendChild(subtitulo);

    return header;
}

/**
 * Cria o container de conteúdo rolável de um modal.
 */
function criarConteudoModal() {
    const conteudo = document.createElement("div");

    Object.assign(conteudo.style, {
        padding: "24px",
        overflowY: "auto",
        flex: "1",
        color: "#242424"
    });

    return conteudo;
}

/**
 * Cria o rodapé de um modal.
 */
function criarRodapeModal() {
    const footer = document.createElement("div");

    Object.assign(footer.style, {
        padding: "16px 24px",
        borderTop: "1px solid #e1e1e1",
        background: "#fafafa",
        display: "flex",
        justifyContent: "flex-end",
        gap: "10px"
    });

    return footer;
}

/**
 * Cria um botão padrão.
 */
function criarBotao(texto, estilo) {
    const botao = document.createElement("button");

    botao.type = "button";
    botao.textContent = texto;

    Object.assign(botao.style, Object.assign({
        padding: "10px 22px",
        borderRadius: "6px",
        border: "none",
        cursor: "pointer",
        fontSize: "14px",
        fontWeight: "600"
    }, estilo));

    return botao;
}

/**
 * Cria um cartão de indicador numérico.
 */
function criarIndicador(tituloIndicador, valor, cor) {
    const card = document.createElement("div");

    Object.assign(card.style, {
        padding: "16px",
        background: "#fafafa",
        border: "1px solid #e1e1e1",
        borderRadius: "8px"
    });

    const label = document.createElement("div");

    label.textContent = tituloIndicador;

    Object.assign(label.style, {
        fontSize: "12px",
        color: "#616161",
        marginBottom: "5px"
    });

    const numero = document.createElement("div");

    numero.textContent = String(valor);

    Object.assign(numero.style, {
        fontSize: "24px",
        fontWeight: "600",
        color: cor
    });

    card.appendChild(label);
    card.appendChild(numero);

    return card;
}

/**
 * Cria a lista rolável de ocorrências.
 *
 * Todos os textos entram via textContent,
 * portanto conteúdo vindo da planilha nunca
 * é interpretado como HTML.
 */
function criarListaOcorrencias(itens) {
    const listaElemento = document.createElement("div");

    Object.assign(listaElemento.style, {
        border: "1px solid #e1e1e1",
        borderRadius: "7px",
        overflowY: "auto",
        maxHeight: "220px",
        background: "#ffffff"
    });

    itens.forEach((item, indice) => {
        const bloco = document.createElement("div");

        Object.assign(bloco.style, {
            padding: "10px 12px",
            fontSize: "12px",
            borderBottom:
                indice < itens.length - 1
                    ? "1px solid #eeeeee"
                    : "none"
        });

        const linhaTitulo = document.createElement("div");

        linhaTitulo.textContent =
            `Linha ${item.linhaExcel} | ` +
            `${item.destinatario || "Sem e-mail"}`;

        Object.assign(linhaTitulo.style, {
            fontWeight: "600",
            color: "#323130",
            wordBreak: "break-word"
        });

        const erro = document.createElement("div");

        erro.textContent = item.erro || "Erro não informado";

        Object.assign(erro.style, {
            color: "#a4262c",
            marginTop: "3px",
            wordBreak: "break-word"
        });

        bloco.appendChild(linhaTitulo);
        bloco.appendChild(erro);

        listaElemento.appendChild(bloco);
    });

    return listaElemento;
}

/**
 * =========================================================
 * POPUP: PLANILHA COM PROBLEMAS
 * =========================================================
 *
 * Exibido quando a pré-validação encontra erros.
 * NÃO possui botão de disparo.
 */
function mostrarErrosPreValidacao(resultado) {
    return new Promise(resolve => {
        const { overlay, modal } = criarEstruturaModal("660px");

        const header = criarCabecalhoModal(
            "❌ Planilha com problemas",
            "Nenhum e-mail foi enviado. Corrija a planilha e execute novamente.",
            { fundo: "#d13438", texto: "#ffffff" }
        );

        const conteudo = criarConteudoModal();

        // Indicadores.
        const resumo = document.createElement("div");

        Object.assign(resumo.style, {
            display: "grid",
            gridTemplateColumns: "1fr 1fr 1fr",
            gap: "12px",
            marginBottom: "22px"
        });

        resumo.appendChild(
            criarIndicador(
                "REGISTROS ANALISADOS",
                resultado.total,
                "#9B0047"
            )
        );

        resumo.appendChild(
            criarIndicador(
                "REGISTROS VÁLIDOS",
                resultado.validos,
                "#107c10"
            )
        );

        resumo.appendChild(
            criarIndicador(
                "COM PROBLEMAS",
                resultado.invalidos,
                "#d13438"
            )
        );

        conteudo.appendChild(resumo);

        // Mensagem.
        const mensagem = document.createElement("div");

        mensagem.textContent =
            "Corrija os problemas abaixo antes de realizar o disparo. " +
            "O disparo permanece bloqueado enquanto existir qualquer " +
            "registro inválido.";

        Object.assign(mensagem.style, {
            padding: "15px",
            background: "#fde7e9",
            border: "1px solid #d13438",
            borderRadius: "7px",
            color: "#a4262c",
            fontSize: "14px",
            lineHeight: "1.5",
            marginBottom: "20px"
        });

        conteudo.appendChild(mensagem);

        // Título da lista.
        const tituloLista = document.createElement("div");

        tituloLista.textContent =
            `PROBLEMAS ENCONTRADOS (${resultado.problemas.length})`;

        Object.assign(tituloLista.style, {
            fontSize: "11px",
            fontWeight: "600",
            color: "#616161",
            marginBottom: "8px"
        });

        conteudo.appendChild(tituloLista);

        conteudo.appendChild(
            criarListaOcorrencias(resultado.problemas)
        );

        // Nota final.
        const nota = document.createElement("div");

        nota.textContent =
            "A lista completa também está disponível no console " +
            "do navegador (console.table).";

        Object.assign(nota.style, {
            fontSize: "12px",
            color: "#616161",
            marginTop: "15px"
        });

        conteudo.appendChild(nota);

        // Rodapé — SEM botão de disparo.
        const footer = criarRodapeModal();

        const botaoFechar = criarBotao("Fechar e corrigir", {
            background: "#9B0047",
            color: "#ffffff"
        });

        botaoFechar.onclick = () => {
            overlay.remove();
            resolve();
        };

        footer.appendChild(botaoFechar);

        modal.appendChild(header);
        modal.appendChild(conteudo);
        modal.appendChild(footer);

        document.body.appendChild(overlay);
    });
}

/**
