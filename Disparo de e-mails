        conteudo.appendChild(mensagem);

        // Lista de falhas.
        if (houveFalhas) {
            const tituloFalhas = document.createElement("div");

            tituloFalhas.textContent = "REGISTROS COM PROBLEMAS";

            Object.assign(tituloFalhas.style, {
                fontSize: "11px",
                fontWeight: "600",
                color: "#616161",
                marginTop: "20px",
                marginBottom: "8px"
            });

            conteudo.appendChild(tituloFalhas);

            conteudo.appendChild(criarListaOcorrencias(falhas));
