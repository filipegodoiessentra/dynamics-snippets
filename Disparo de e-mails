                "durante o processamento do lote.";

            Object.assign(mensagem.style, {
                padding: "15px",
                background: "#dff6dd",
                border: "1px solid #107c10",
                borderRadius: "7px",
                color: "#0b6a0b",
                fontSize: "14px",
                lineHeight: "1.5"
            });
        } else {
            mensagem.textContent =
                `⚠️ Atenção: ${falhas.length} registro(s) apresentaram ` +
                "falha durante o envio. Os detalhes também estão " +
                "disponíveis no console do navegador.";

            Object.assign(mensagem.style, {
                padding: "15px",
                background: "#fff4ce",
                border: "1px solid #e6c74c",
                borderRadius: "7px",
