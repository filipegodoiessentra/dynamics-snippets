            fontWeight: "500"
        });

        const botaoDisparar = criarBotao(
            `🚀 Disparar ${lista.length} e-mail(s)`,
            {
                background: "#107c10",
                color: "#ffffff"
            }
        );

        // Trava contra duplo clique / dupla resolução.
        let decidido = false;

        botaoCancelar.onclick = () => {
            if (decidido) {
                return;
            }

            decidido = true;

            overlay.remove();
            resolve(false);
        };

        botaoDisparar.onclick = () => {
            if (decidido) {
                return;
            }

            decidido = true;

            botaoDisparar.disabled = true;
            botaoCancelar.disabled = true;

            botaoDisparar.textContent = "⏳ Iniciando disparo...";
            botaoDisparar.style.background = "#666666";
            botaoDisparar.style.cursor = "default";

            // Pequeno delay apenas para permitir que
            // a alteração visual do botão seja percebida.
            setTimeout(() => {
                overlay.remove();
                resolve(true);
            }, 300);
        };

        footer.appendChild(botaoCancelar);
        footer.appendChild(botaoDisparar);

        modal.appendChild(header);
        modal.appendChild(conteudo);
        modal.appendChild(footer);

        document.body.appendChild(overlay);
    });
}

/**
