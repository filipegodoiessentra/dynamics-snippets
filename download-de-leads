async function exportarLeadsBRV4() {

    const campanha = "f98d08d3-191e-f111-8341-000d3ab84eef";

    const leadsResp = await Xrm.WebApi.retrieveMultipleRecords(
        "lead",
        `?$filter=_campaignid_value eq ${campanha}`
    );

    const linhas = [];

    for (const lead of leadsResp.entities) {

        let stage = "";

        try {

            const bpf = await Xrm.WebApi.retrieveMultipleRecords(
                "new_bpf_698a878dafd64a32b4d5461408a8256a",
                `?$filter=_bpf_leadid_value eq ${lead.leadid}`
            );

            if (bpf.entities.length) {
                stage =
                    bpf.entities[0]["_activestageid_value@OData.Community.Display.V1.FormattedValue"] || "";
            }

        } catch (e) {
            console.log("Erro no lead:", lead.fullname);
        }

        linhas.push({
            Owner: lead["_ownerid_value@OData.Community.Display.V1.FormattedValue"] || "",
            Name: lead.fullname || "",
            Topic: lead.subject || "",
            Company: lead.companyname || "",
            City: lead.address1_city || "",
            Country: lead.address1_country || "",
            Priority: lead["prioritycode@OData.Community.Display.V1.FormattedValue"] || "",
            Status: lead["statuscode@OData.Community.Display.V1.FormattedValue"] || "",
            Campaign: lead["_campaignid_value@OData.Community.Display.V1.FormattedValue"] || "",
            CreatedOn: lead["createdon@OData.Community.Display.V1.FormattedValue"] || "",
            ModifiedOn: lead["modifiedon@OData.Community.Display.V1.FormattedValue"] || "",
            Stage: stage
        });

        console.log(
            `Processado ${linhas.length} de ${leadsResp.entities.length}`
        );
    }

    const headers = Object.keys(linhas[0]);

    const csv = [
        headers.join(";"),
        ...linhas.map(r =>
            headers.map(h =>
                `"${String(r[h] ?? "")
                    .replace(/[\r\n]+/g, " ")
                    .replace(/\s+/g, " ")
                    .replace(/"/g, '""')
                    .trim()}"`
            ).join(";")
        )
    ].join("\n");

    const blob = new Blob(
        ["\ufeff" + csv],
        { type: "text/csv;charset=utf-8;" }
    );

    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download =
        `BR_V4_${linhas.length}_Leads_Com_Stage.csv`;
    a.click();

    console.log("Exportação concluída");
}

exportarLeadsBRV4();
